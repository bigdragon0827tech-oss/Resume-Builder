<Window x:Class="ResumeBuilder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ResumeBuilder"
 Title="Resume Builder v1.0" Height="820" Width="1400" MinHeight="640" MinWidth="1100"
 Background="{DynamicResource Bg.App}">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <Border Grid.Column="0" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
     <TextBlock Text="Resume Builder" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="v1.0" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,2,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
     <Button x:Name="ThemeToggleButton" Content="Use light theme" Style="{DynamicResource BtnGhost}"
             HorizontalAlignment="Stretch" Click="ThemeToggle_Click"/>
     <Button Content="Refresh Input" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="Refresh_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,8,0,0">
      <RadioButton x:Name="NavDashboard" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   IsChecked="True" Checked="Nav_Checked" Tag="Dashboard" ToolTip="Dashboard">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M2,2 H7 V7 H2 Z M9,2 H14 V7 H9 Z M2,9 H7 V14 H2 Z M9,9 H14 V14 H9 Z" Margin="0,0,10,0"/>
        <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavJobBrowser" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="JobBrowser" ToolTip="Job Browser">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M1,3 H15 V13 H1 Z M1,3 L8,9 L15,3" Margin="0,0,10,0"/>
        <TextBlock Text="Job Browser" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavTaskQueue" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="TaskQueue" ToolTip="Task Queue">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M2,3 H14 V5 H2 Z M2,7 H14 V9 H2 Z M2,11 H10 V13 H2 Z" Margin="0,0,10,0"/>
        <TextBlock Text="Task Queue" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavAiWorkspace" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="AiWorkspace" ToolTip="AI Workspace">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M8,1 L10,6 L15,6 L11,9 L13,14 L8,11 L3,14 L5,9 L1,6 L6,6 Z" Margin="0,0,10,0"/>
        <TextBlock Text="AI Workspace" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavDocuments" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="Documents" ToolTip="Documents">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M4,1 H10 L13,4 V15 H4 Z M10,1 V4 H13" Margin="0,0,10,0"/>
        <TextBlock Text="Documents" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavApplications" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="Applications" ToolTip="Applications">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M2,2 H6 V6 H2 Z M10,2 H14 V6 H10 Z M2,10 H6 V14 H2 Z M9,9 L12,14 L15,9 Z" Margin="0,0,10,0"/>
        <TextBlock Text="Applications" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavSettings" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="Settings" ToolTip="Settings">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M6,1 H10 L11,3 H14 V5 L12,6 L14,8 V10 H11 L10,12 H6 L5,10 H2 V8 L4,6 L2,5 V3 H5 Z M8,6 A2,2 0 1,0 8.01,6" Margin="0,0,10,0"/>
        <TextBlock Text="Settings" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <!-- Main column -->
  <Grid Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="52"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
    <DockPanel Margin="20,0">
     <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock x:Name="ContextChip" DockPanel.Dock="Right" VerticalAlignment="Center"
                Foreground="{DynamicResource Text.Secondary}" FontSize="12"/>
    </DockPanel>
   </Border>

   <Grid Grid.Row="1" Margin="0">
    <!-- Dashboard -->
    <local:DashboardPage x:Name="DashboardView" Visibility="Visible"/>

    <!-- Job Browser (embedded; profile stays alive while Collapsed) -->
    <local:JobBrowserWindow x:Name="JobBrowserView" Visibility="Collapsed"/>

    <!-- Task Queue -->
    <Grid x:Name="TaskQueueView" Visibility="Collapsed" Margin="24">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="Task Queue" Style="{DynamicResource PageTitleStyle}"/>
       <TextBlock Text="Active jobs stay visible until completed. History shows finished resumes." Style="{DynamicResource PageSubtitleStyle}"/>
       <Border Background="{DynamicResource Bg.Input}" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
         <Button x:Name="ActiveViewButton" Content="Active (0)" Height="30" MinWidth="120" Margin="0,0,2,0"
                 Style="{DynamicResource BtnGhost}" FontWeight="SemiBold"
                 Click="ActiveView_Click" ToolTip="Queued, processing and failed jobs"/>
         <Button x:Name="HistoryViewButton" Content="History (0)" Height="30" MinWidth="120"
                 Style="{DynamicResource BtnGhost}"
                 Click="HistoryView_Click" ToolTip="Completed jobs"/>
        </StackPanel>
       </Border>
       <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,10"/>
      </StackPanel>
      <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="6">
       <Grid>
        <ListBox x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged" BorderThickness="0" Background="Transparent">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Border Padding="4,2">
            <DockPanel>
             <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,10,2">
              <Border.Style>
               <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Text.Muted}"/>
                <Style.Triggers>
                 <DataTrigger Binding="{Binding Status}" Value="Queued">
                  <Setter Property="Background" Value="{DynamicResource Text.Muted}"/>
                 </DataTrigger>
                 <DataTrigger Binding="{Binding Status}" Value="Processing">
                  <Setter Property="Background" Value="{DynamicResource Info}"/>
                 </DataTrigger>
                 <DataTrigger Binding="{Binding Status}" Value="Completed">
                  <Setter Property="Background" Value="{DynamicResource Success}"/>
                 </DataTrigger>
                 <DataTrigger Binding="{Binding Status}" Value="Failed">
                  <Setter Property="Background" Value="{DynamicResource Danger}"/>
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </Border.Style>
             </Border>
             <StackPanel>
              <TextBlock Text="{Binding Company}" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding StatusDisplay}" Margin="0,6,0,0" Foreground="{DynamicResource Text.Muted}" FontSize="11.5"/>
             </StackPanel>
            </DockPanel>
           </Border>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="QueueEmptyText" Text="No jobs in this view." Style="{DynamicResource EmptyStateStyle}"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
      </Border>
     </Grid>
     <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" Text="Selected job" Style="{DynamicResource SectionTitleStyle}"/>
       <Button DockPanel.Dock="Bottom" Content="Open in AI Workspace" Margin="0,16,0,0"
               Style="{DynamicResource BtnPrimary}" Click="OpenAiWorkspace_Click"/>
       <StackPanel>
        <TextBlock x:Name="DetailCompany" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailTitle" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
        <Border Background="{DynamicResource Bg.Input}" CornerRadius="6" Padding="10" Margin="0,14,0,0">
         <TextBlock x:Name="DetailMeta" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12"/>
        </Border>
       </StackPanel>
      </DockPanel>
     </Border>
    </Grid>

    <!-- AI Workspace -->
    <Grid x:Name="AiWorkspaceView" Visibility="Collapsed" Margin="16">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Border Style="{DynamicResource CardStyle}">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="AI Workspace" Style="{DynamicResource SectionTitleStyle}"/>
        <TextBlock Text="Job context and processing controls. ChatGPT stays on the right."
                   Foreground="{DynamicResource Text.Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
       </StackPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <Button x:Name="ProcessSelectedButton" Content="Prepare &amp; Send to ChatGPT" Style="{DynamicResource BtnPrimary}"
                Height="40" IsEnabled="False" Click="ProcessSelected_Click" Margin="0,0,0,8"/>
        <Button x:Name="GenerateDocumentsButton" Content="Generate Documents" Height="34" IsEnabled="False"
                Click="GenerateDocuments_Click" Margin="0,0,0,8"/>
        <Button Content="Show Task Queue" Style="{DynamicResource BtnGhost}" Click="ShowTaskQueue_Click"/>
       </StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="Selected job" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"/>
         <TextBlock x:Name="WorkspaceCompany" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0"/>
         <TextBlock x:Name="WorkspaceTitle" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
         <Border Background="{DynamicResource Bg.Input}" CornerRadius="6" Padding="10" Margin="0,12,0,0">
          <TextBlock x:Name="WorkspaceMeta" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12"/>
         </Border>
         <TextBlock Text="Prompt &amp; capture" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}" Margin="0,16,0,6"/>
         <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"
                    Text="Prepare builds the request once. When ChatGPT finishes, the answer is read in the background from this pane — no focus stealing and no clipboard use. Manual Copy (Ctrl+Shift+;) remains available as a fallback."/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
     <Grid Grid.Column="2">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
              CornerRadius="8,8,0,0" Padding="14,10">
       <DockPanel>
        <ProgressBar x:Name="ChatBusyBar" DockPanel.Dock="Right" Width="100" Height="3" Margin="12,0,0,0"
                     IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
        <TextBlock Text="ChatGPT" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <Border x:Name="ChatHostPanel" Grid.Row="1" Background="{DynamicResource Bg.Input}"
              BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8"/>
     </Grid>
    </Grid>

    <!-- Documents -->
    <local:DocumentsPage x:Name="DocumentsView" Visibility="Collapsed"/>

    <!-- Settings + Applications (same control; tab selected by navigation) -->
    <local:SettingsWindow x:Name="SettingsView" Visibility="Collapsed"/>
   </Grid>

   <!-- Queue command bar -->
   <Border x:Name="QueueCommandBar" Grid.Row="2" Background="{DynamicResource Bg.Surface}"
           BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,10" Visibility="Collapsed">
    <UniformGrid Columns="6">
     <Button x:Name="StartQueueButton" Content="Start Queue" Height="34" Margin="0,0,6,0" IsEnabled="False" Click="StartQueue_Click"/>
     <Button x:Name="PauseQueueButton" Content="Pause Queue" Height="34" Margin="3,0" IsEnabled="False" Click="PauseQueue_Click"/>
     <Button x:Name="StopQueueButton" Content="Stop Queue" Height="34" Margin="3,0" IsEnabled="False" Click="StopQueue_Click"/>
     <Button x:Name="SkipJobButton" Content="Skip Job" Height="34" Margin="3,0" IsEnabled="False" Click="SkipJob_Click"/>
     <Button x:Name="RetryFailedButton" Content="Retry Failed" Height="34" Margin="3,0" IsEnabled="False" Click="RetryFailed_Click"/>
     <Button Content="Prepare &amp; Send" Height="34" Margin="6,0,0,0" Style="{DynamicResource BtnPrimary}" Click="ProcessSelected_Click"/>
    </UniformGrid>
   </Border>

   <!-- Status rail -->
   <Border Grid.Row="3" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,8">
    <DockPanel>
     <ProgressBar x:Name="ShellBusyBar" DockPanel.Dock="Right" Width="120" Height="3" Margin="12,0,0,0"
                  IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
     <StackPanel>
      <TextBlock x:Name="ImportMessage" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
      <TextBlock x:Name="QueueStatus" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" FontSize="12" Margin="0,2,0,0"/>
      <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Foreground="{DynamicResource Success}" FontSize="12" Margin="0,2,0,0"/>
      <TextBlock x:Name="DocumentStatus" TextWrapping="Wrap" Foreground="{DynamicResource Info}" FontSize="12" Margin="0,2,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
  </Grid>

  <!-- Keeps ChatGPT WebView2 in the visual tree (Visible, 1×1) while other pages are shown so
       background capture and completion polling are not suspended by Collapsed. -->
  <Border x:Name="ChatKeepAliveHost" Grid.Column="0" Grid.ColumnSpan="2"
          Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
          Opacity="0" IsHitTestVisible="False" Background="Transparent"/>
 </Grid>
</Window>
