<Window x:Class="ResumeBuilder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Resume Builder A6.6.12" Height="760" Width="1250" MinHeight="560" MinWidth="900">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#F3F7F8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
   <Grid Margin="14,0"><TextBlock Text="Resume Builder — A6.6.12" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Refresh Input" Margin="0,8,8,8" Padding="12,0" Click="Refresh_Click"/>
     <Button Content="⚙ Settings" Margin="0,8,0,8" Padding="12,0" Click="Settings_Click"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="TASK QUEUE" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="SummaryText" Margin="0,5,0,10" Foreground="#666"/></StackPanel>
    <ListBox Grid.Row="1" x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged">
     <ListBox.ItemTemplate><DataTemplate><Border Padding="8" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
      <StackPanel><TextBlock Text="{Binding Company}" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding StatusDisplay}" Margin="0,4,0,0" Foreground="#555"/></StackPanel>
     </Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
     <TextBlock x:Name="ImportMessage" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"/>
     <TextBlock x:Name="QueueStatus" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4"/>
     <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Foreground="#2A6B4F" Margin="0,0,0,4"/>
     <TextBlock x:Name="DocumentStatus" TextWrapping="Wrap" Foreground="#40506B" Margin="0,0,0,8"/>
     <Button x:Name="ProcessSelectedButton" Content="▶ PREPARE &amp; SEND TO CHATGPT" Height="40" IsEnabled="False" Click="ProcessSelected_Click"/>
     <UniformGrid Columns="2" Margin="0,7,0,0">
      <Button x:Name="StartQueueButton" Content="▶ Start Queue" Height="34" Margin="0,0,3,0" IsEnabled="False" Click="StartQueue_Click"/>
      <Button x:Name="PauseQueueButton" Content="⏸ Pause Queue" Height="34" Margin="3,0,0,0" IsEnabled="False" Click="PauseQueue_Click"/>
     </UniformGrid>
     <UniformGrid Columns="2" Margin="0,5,0,0">
      <Button x:Name="StopQueueButton" Content="⏹ Stop Queue" Height="34" Margin="0,0,3,0" IsEnabled="False" Click="StopQueue_Click"/>
      <Button x:Name="SkipJobButton" Content="⏭ Skip Job" Height="34" Margin="3,0,0,0" IsEnabled="False" Click="SkipJob_Click"/>
     </UniformGrid>
     <Button x:Name="GenerateDocumentsButton" Content="Generate Documents" Height="34" Margin="0,7,0,0" IsEnabled="False" Click="GenerateDocuments_Click"/>
     <Button x:Name="RetryFailedButton" Content="Retry Failed" Height="34" Margin="0,7,0,0" IsEnabled="False" Click="RetryFailed_Click"/>
    </StackPanel>
   </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,0,0,1"><TextBlock Text="ChatGPT" FontWeight="Bold" FontSize="16" Margin="14,0" VerticalAlignment="Center"/></Border>
    <wv2:WebView2 x:Name="ChatView" Grid.Row="1"/>
   </Grid>
  </Grid>
 </Grid>
</Window>