<Window x:Class="ResumeBuilder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ResumeBuilder"
 Title="Resume Builder v3.0" Icon="Assets/ResumeBuilder.ico" Height="820" Width="1400" MinHeight="640" MinWidth="1100"
 Background="{DynamicResource Bg.App}">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <Border Grid.Column="0" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,8">
     <TextBlock Text="Resume Builder" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="v3.0" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,2,0,0"/>
     <StackPanel x:Name="ProfileChip" Orientation="Horizontal" Margin="0,12,0,0">
      <Border x:Name="ProfileAvatarHost" Width="28" Height="28" VerticalAlignment="Center"/>
      <TextBlock x:Name="ActiveProfileText" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="130"
                 FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"
                 TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Button x:Name="SwitchProfileButton" Content="Switch Profile" HorizontalAlignment="Left"
             Margin="0,6,0,0" MinHeight="28" Height="28" Padding="8,0" FontSize="12"
             Style="{DynamicResource SecondaryButtonStyle}" Click="SwitchProfile_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
     <Button x:Name="ThemeToggleButton" Content="Use light theme" Height="34" Style="{DynamicResource BtnGhost}"
             HorizontalAlignment="Stretch" Click="ThemeToggle_Click"/>
     <Button Content="Refresh Input" Height="34" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="Refresh_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,8,0,0">
      <RadioButton x:Name="NavJobBrowser" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="JobBrowser" ToolTip="Job Browser">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M1,3 H15 V13 H1 Z M1,3 L8,9 L15,3" Margin="0,0,10,0"/>
        <TextBlock Text="Job Browser" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavTaskQueue" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   IsChecked="True" Checked="Nav_Checked" Tag="TaskQueue" ToolTip="Task Queue">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M2,3 H14 V5 H2 Z M2,7 H14 V9 H2 Z M2,11 H10 V13 H2 Z" Margin="0,0,10,0"/>
        <TextBlock Text="Task Queue" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavEmailTasks" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="EmailTasks" ToolTip="Email Tasks">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M1,3 H15 V12 H1 Z M1,3 L8,8 L15,3" Margin="0,0,10,0"/>
        <TextBlock Text="Email Tasks" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavAiWorkspace" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="AiWorkspace" ToolTip="AI Workspace">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M8,1 L10,6 L15,6 L11,9 L13,14 L8,11 L3,14 L5,9 L1,6 L6,6 Z" Margin="0,0,10,0"/>
        <TextBlock Text="AI Workspace" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavApplications" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="Applications" ToolTip="Applications">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M2,2 H6 V6 H2 Z M10,2 H14 V6 H10 Z M2,10 H6 V14 H2 Z M9,9 L12,14 L15,9 Z" Margin="0,0,10,0"/>
        <TextBlock Text="Applications" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavSettings" GroupName="ShellNav" Style="{DynamicResource NavButtonStyle}"
                   Checked="Nav_Checked" Tag="Settings" ToolTip="Settings">
       <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Data="M6,1 H10 L11,3 H14 V5 L12,6 L14,8 V10 H11 L10,12 H6 L5,10 H2 V8 L4,6 L2,5 V3 H5 Z M8,6 A2,2 0 1,0 8.01,6" Margin="0,0,10,0"/>
        <TextBlock Text="Settings" VerticalAlignment="Center"/>
       </StackPanel>
      </RadioButton>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <!-- Main column -->
  <Grid Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="52"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Border Grid.Row="0" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
    <DockPanel Margin="20,0">
     <TextBlock x:Name="PageTitleText" Text="Task Queue" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock x:Name="ContextChip" DockPanel.Dock="Right" VerticalAlignment="Center"
                Foreground="{DynamicResource Text.Secondary}" FontSize="12"/>
    </DockPanel>
   </Border>

   <Grid Grid.Row="1" Margin="0">
    <!-- Job Browser (embedded; profile stays alive while Collapsed) -->
    <local:JobBrowserWindow x:Name="JobBrowserView" Visibility="Collapsed"/>

    <!-- Task Queue -->
    <Grid x:Name="TaskQueueView" Visibility="Visible" Margin="24">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="Queued, processing, and failed jobs." Style="{DynamicResource PageSubtitleStyle}"/>
       <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,10"/>
      </StackPanel>
      <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="6">
       <Grid>
        <ListBox x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged" BorderThickness="0" Background="Transparent">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Border Padding="4,2">
            <DockPanel>
             <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,10,2">
              <Border.Style>
               <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Text.Muted}"/>
                <Style.Triggers>
                 <DataTrigger Binding="{Binding Status}" Value="Queued">
                  <Setter Property="Background" Value="{DynamicResource Text.Muted}"/>
                 </DataTrigger>
                 <DataTrigger Binding="{Binding Status}" Value="Processing">
                  <Setter Property="Background" Value="{DynamicResource Info}"/>
                 </DataTrigger>
                 <DataTrigger Binding="{Binding Status}" Value="Completed">
                  <Setter Property="Background" Value="{DynamicResource Success}"/>
                 </DataTrigger>
                 <DataTrigger Binding="{Binding Status}" Value="Failed">
                  <Setter Property="Background" Value="{DynamicResource Danger}"/>
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </Border.Style>
             </Border>
             <Grid>
              <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0">
               <Border Style="{DynamicResource IconFrameStyle}" Margin="0,0,8,0" DockPanel.Dock="Left">
                <Grid>
                 <Path Data="M1,3 H15 V13 H1 Z M3,11 L6,7 L8,9 L11,5 L13,11 Z" Stretch="Uniform" Margin="3"
                       Fill="{DynamicResource Text.Muted}" IsHitTestVisible="False">
                  <Path.Style>
                   <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                     <DataTrigger Binding="{Binding CompanyIcon}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible"/>
                     </DataTrigger>
                    </Style.Triggers>
                   </Style>
                  </Path.Style>
                 </Path>
                 <Image Source="{Binding CompanyIcon}" Stretch="UniformToFill">
                  <Image.Style>
                   <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                     <DataTrigger Binding="{Binding CompanyIcon}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                     </DataTrigger>
                    </Style.Triggers>
                   </Style>
                  </Image.Style>
                 </Image>
                </Grid>
               </Border>
               <TextBlock Text="{Binding Company}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis" ToolTip="{Binding Company}"/>
              </DockPanel>
              <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
              <TextBlock Grid.Row="2" Text="{Binding StatusDisplay}" Margin="0,6,0,0" Foreground="{DynamicResource Text.Muted}" FontSize="11.5"/>
             </Grid>
            </DockPanel>
           </Border>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="QueueEmptyText" Text="No jobs in this view." Style="{DynamicResource EmptyStateStyle}"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
      </Border>
     </Grid>
     <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" Text="Selected job" Style="{DynamicResource SectionTitleStyle}"/>
       <Button DockPanel.Dock="Bottom" Content="Open in AI Workspace" Height="34" Margin="0,16,0,0"
               Style="{DynamicResource BtnPrimary}" Click="OpenAiWorkspace_Click"/>
       <StackPanel>
        <StackPanel Orientation="Horizontal">
         <Border x:Name="DetailCompanyBadge" Width="28" Height="28" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Bg.Input}" Margin="0,0,10,0" VerticalAlignment="Center">
          <Grid>
           <Path x:Name="DetailCompanyFallback" Data="M1,3 H15 V13 H1 Z M3,11 L6,7 L8,9 L11,5 L13,11 Z" Stretch="Uniform" Margin="5" Fill="{DynamicResource Text.Muted}"/>
           <Image x:Name="DetailCompanyIcon" Stretch="UniformToFill"/>
          </Grid>
         </Border>
         <TextBlock x:Name="DetailCompany" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="DetailTitle" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
        <Border Background="{DynamicResource Bg.Input}" CornerRadius="6" Padding="10" Margin="0,14,0,0">
         <TextBlock x:Name="DetailMeta" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12"/>
        </Border>
       </StackPanel>
      </DockPanel>
     </Border>
    </Grid>

    <!-- AI Workspace -->
    <Grid x:Name="AiWorkspaceView" Visibility="Collapsed" Margin="24">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Border Style="{DynamicResource CardStyle}">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Job context and processing controls. ChatGPT stays on the right."
                   Foreground="{DynamicResource Text.Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,16"/>
       </StackPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
        <Button x:Name="ProcessSelectedButton" Content="Prepare &amp; Send to ChatGPT" Style="{DynamicResource BtnPrimary}"
                Height="34" IsEnabled="False" Click="ProcessSelected_Click" Margin="0,0,0,8"/>
        <Button x:Name="GenerateDocumentsButton" Content="Generate Documents" Height="34" IsEnabled="False"
                Click="GenerateDocuments_Click" Margin="0,0,0,8"/>
        <Button Content="Show Task Queue" Height="34" Style="{DynamicResource BtnGhost}" Click="ShowTaskQueue_Click"/>
       </StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="Selected job" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"/>
         <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Border x:Name="WorkspaceCompanyBadge" Width="26" Height="26" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Bg.Input}" Margin="0,0,8,0" VerticalAlignment="Center">
           <Grid>
            <Path x:Name="WorkspaceCompanyFallback" Data="M1,3 H15 V13 H1 Z M3,11 L6,7 L8,9 L11,5 L13,11 Z" Stretch="Uniform" Margin="4" Fill="{DynamicResource Text.Muted}"/>
            <Image x:Name="WorkspaceCompanyIcon" Stretch="UniformToFill"/>
           </Grid>
          </Border>
          <TextBlock x:Name="WorkspaceCompany" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
         </StackPanel>
         <TextBlock x:Name="WorkspaceTitle" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
         <Border Background="{DynamicResource Bg.Input}" CornerRadius="6" Padding="10" Margin="0,12,0,0">
          <TextBlock x:Name="WorkspaceMeta" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="12"/>
         </Border>
         <TextBlock Text="Prompt &amp; capture" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}" Margin="0,16,0,6"/>
         <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"
                    Text="Prepare builds the request once. When ChatGPT finishes, the answer is read in the background from this pane — no focus stealing and no clipboard use. Manual Copy (Ctrl+Shift+;) remains available as a fallback."/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
     <Grid Grid.Column="2">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
              CornerRadius="8,8,0,0" Padding="14,10">
       <DockPanel>
        <ProgressBar x:Name="ChatBusyBar" DockPanel.Dock="Right" Width="100" Height="3" Margin="12,0,0,0"
                     IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
        <TextBlock Text="ChatGPT" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <Border x:Name="ChatHostPanel" Grid.Row="1" Background="{DynamicResource Bg.Input}"
              BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8"/>
     </Grid>
    </Grid>

    <!-- Settings + Applications (same control; tab selected by navigation) -->
    <local:EmailTasksPage x:Name="EmailTasksView" Visibility="Collapsed"/>

    <local:SettingsWindow x:Name="SettingsView" Visibility="Collapsed"/>
   </Grid>

   <!-- Queue command bar -->
   <Border x:Name="QueueCommandBar" Grid.Row="2" Background="{DynamicResource Bg.Surface}"
           BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,10" Visibility="Visible">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="Order" VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource Text.Secondary}"/>
      <ComboBox x:Name="QueueOrderBox" Width="120" Height="34" SelectionChanged="QueueOrder_Changed"
                ToolTip="Queue runs the oldest waiting job first. Stack runs the newest waiting job first."/>
     </StackPanel>
    <UniformGrid Columns="6">
     <Button x:Name="StartQueueButton" Content="Start Queue" Margin="0,0,6,0" IsEnabled="False"
             Style="{DynamicResource PrimaryButtonStyle}" Click="StartQueue_Click"/>
     <Button x:Name="PauseQueueButton" Content="Pause Queue" Margin="3,0" IsEnabled="False"
             Style="{DynamicResource SecondaryButtonStyle}" Click="PauseQueue_Click"/>
     <Button x:Name="StopQueueButton" Content="Stop Queue" Margin="3,0" IsEnabled="False"
             Style="{DynamicResource DestructiveButtonStyle}" Click="StopQueue_Click"/>
     <Button x:Name="SkipJobButton" Content="Skip Job" Margin="3,0" IsEnabled="False"
             Style="{DynamicResource SecondaryButtonStyle}" Click="SkipJob_Click"/>
     <Button x:Name="RetryFailedButton" Content="Retry Failed" Margin="3,0" IsEnabled="False"
             Style="{DynamicResource SecondaryButtonStyle}" Click="RetryFailed_Click"/>
     <Button Content="Prepare &amp; Send" Margin="6,0,0,0" Style="{DynamicResource PrimaryButtonStyle}" Click="ProcessSelected_Click"/>
    </UniformGrid>
    </DockPanel>
   </Border>

   <!-- Status rail -->
   <Border Grid.Row="3" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,8">
    <DockPanel>
     <ProgressBar x:Name="ShellBusyBar" DockPanel.Dock="Right" Width="120" Height="3" Margin="12,0,0,0"
                  IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
     <StackPanel>
      <TextBlock x:Name="ImportMessage" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
      <TextBlock x:Name="QueueStatus" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" FontSize="12" Margin="0,2,0,0"/>
      <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Foreground="{DynamicResource Success}" FontSize="12" Margin="0,2,0,0"/>
      <TextBlock x:Name="DocumentStatus" TextWrapping="Wrap" Foreground="{DynamicResource Info}" FontSize="12" Margin="0,2,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
  </Grid>

  <!-- Keeps ChatGPT WebView2 in the visual tree (Visible, 1×1) while other pages are shown so
       background capture and completion polling are not suspended by Collapsed. -->
  <Border x:Name="ChatKeepAliveHost" Grid.Column="0" Grid.ColumnSpan="2"
          Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
          Opacity="0" IsHitTestVisible="False" Background="Transparent"/>
 </Grid>
</Window>
