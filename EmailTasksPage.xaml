<UserControl x:Class="ResumeBuilder.EmailTasksPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="24" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <TextBlock Text="Paste one recruiter email or one job description, then add it to the list."
             Style="{DynamicResource PageSubtitleStyle}" Margin="0,0,0,12"/>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="16"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <Border Style="{DynamicResource CardStyle}" VerticalAlignment="Top">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="Paste" Style="{DynamicResource SectionTitleStyle}"/>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Orientation="Horizontal">
      <Button Content="Extract" Height="34" Width="120" Margin="0,0,8,0"
              Style="{DynamicResource BtnPrimary}" Click="Extract_Click"/>
      <Button x:Name="AddButton" Content="Add to Email Tasks" Height="34" Padding="14,0" IsEnabled="False"
              Click="Add_Click"/>
     </StackPanel>
     <TextBox x:Name="PasteBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="False"
              Height="92" MinHeight="92" MaxHeight="92"
              Padding="10,8" Opacity="1"
              VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
              Foreground="{DynamicResource Text.Primary}"
              Background="{DynamicResource Bg.Input}"
              CaretBrush="{DynamicResource Text.Primary}"
              SelectionBrush="{DynamicResource Accent.Muted}"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Loaded="PasteBox_Loaded"/>
    </DockPanel>
   </Border>

   <Border Grid.Column="2" Style="{DynamicResource CardStyle}" VerticalAlignment="Top">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="Extracted" Style="{DynamicResource SectionTitleStyle}"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="Sender" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="SenderBox" Height="32" Margin="0,0,0,8"/>
       <TextBlock Text="Company" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="CompanyBox" Height="32" Margin="0,0,0,8"/>
       <TextBlock Text="Job Title" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="TitleBox" Height="32" Margin="0,0,0,8"/>
       <TextBlock Text="Email URL" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="ResultUrlBox" Height="32" Margin="0,0,0,8"/>
       <TextBlock Text="Job Description / JD" Foreground="{DynamicResource Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                Height="120" MinHeight="120" MaxHeight="120"
                VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>

  <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="6" Margin="0,14,0,0">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="8,6,8,8">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
      <Button x:Name="StartEmailButton" Content="Start Email Tasks" Margin="0,0,8,0"
              Style="{DynamicResource PrimaryButtonStyle}" Click="StartEmail_Click"/>
      <Button x:Name="TailorSelectedButton" Content="Tailor Selected"
              Style="{DynamicResource PrimaryButtonStyle}" Click="TailorSelected_Click"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
      <ProgressBar x:Name="EmailBusyBar" Width="72" Height="3" Margin="0,0,10,0" IsIndeterminate="True"
                   Visibility="Collapsed" VerticalAlignment="Center"/>
      <TextBlock x:Name="PageStatus" VerticalAlignment="Center"
                 Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
     </StackPanel>
    </DockPanel>
   <Grid>
    <DataGrid x:Name="EmailGrid" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" FontSize="12"
              BorderThickness="0" Background="Transparent"
              RowBackground="{DynamicResource Bg.Surface}"
              AlternatingRowBackground="{DynamicResource Bg.SurfaceRaised}"
              Foreground="{DynamicResource Text.Primary}"
              RowHeight="44" CanUserAddRows="False" CanUserResizeRows="False"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
     <DataGrid.Resources>
      <Style TargetType="DataGridColumnHeader">
       <Setter Property="Background" Value="{DynamicResource Bg.SurfaceRaised}"/>
       <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
       <Setter Property="FontSize" Value="10.5"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="Padding" Value="10,7"/>
       <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
       <Setter Property="BorderThickness" Value="0,0,0,1"/>
       <Setter Property="HorizontalContentAlignment" Value="Left"/>
      </Style>
      <Style TargetType="DataGridCell">
       <Setter Property="BorderThickness" Value="0"/>
       <Setter Property="Padding" Value="8,0"/>
       <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
       <Setter Property="VerticalContentAlignment" Value="Center"/>
       <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
         <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Trigger>
       </Style.Triggers>
      </Style>
     </DataGrid.Resources>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Sender" Binding="{Binding Sender}" Width="*" MinWidth="120" ElementStyle="{DynamicResource GridTextStyle}"/>
      <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*" MinWidth="110" ElementStyle="{DynamicResource GridTextStyle}"/>
      <DataGridTextColumn Header="Job Title" Binding="{Binding JobTitle}" Width="1.4*" MinWidth="150" ElementStyle="{DynamicResource GridTextStyle}"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" MinWidth="90"/>
      <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="130" MinWidth="120"/>
      <DataGridTemplateColumn Header="Actions" Width="600" MinWidth="600">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal">
          <Button Content="Tailor" Margin="0,0,4,0" Click="Tailor_Click" IsEnabled="{Binding CanTailor}"
                  Style="{DynamicResource CompactPrimaryButtonStyle}"/>
          <Button Content="Resume" Margin="0,0,4,0" Click="Resume_Click" IsEnabled="{Binding CanOpenResume}"
                  Style="{DynamicResource CompactSecondaryButtonStyle}" ToolTip="Open the DOCX"/>
          <Button Content="PDF" Margin="0,0,4,0" Click="Pdf_Click" IsEnabled="{Binding CanOpenPdf}"
                  Style="{DynamicResource CompactSecondaryButtonStyle}" ToolTip="Open the PDF"/>
          <Button Content="Folder" Margin="0,0,4,0" Click="Folder_Click" IsEnabled="{Binding CanOpenFolder}"
                  Style="{DynamicResource CompactSecondaryButtonStyle}" ToolTip="Open the resume folder"/>
          <Button Content="Open Email" Margin="0,0,4,0" Click="OpenEmail_Click" IsEnabled="{Binding CanOpenEmail}"
                  Style="{DynamicResource CompactSecondaryButtonStyle}"/>
          <Button Content="Retry" Margin="0,0,4,0" Click="Retry_Click" IsEnabled="{Binding CanRetry}"
                  Style="{DynamicResource CompactSecondaryButtonStyle}"/>
          <Button Content="Remove" Click="Remove_Click">
           <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource CompactDestructiveButtonStyle}">
             <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="Processing">
               <Setter Property="IsEnabled" Value="False"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Button.Style>
          </Button>
         </StackPanel>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="EmptyText" Text="No email tasks yet." Style="{DynamicResource EmptyStateStyle}"
               Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid>
   </DockPanel>
  </Border>
 </Grid>
 </ScrollViewer>
</UserControl>
