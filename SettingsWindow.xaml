<Window x:Class="ResumeBuilder.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 Title="Settings / Inspector" Height="700" Width="1000">
 <Window.Resources>
  <!-- ===================================================================
       Applications dashboard: light surfaces, one accent, semantic status
       colours. Presentation only — no behaviour lives here.
       =================================================================== -->
  <SolidColorBrush x:Key="Accent" Color="#1F4E79"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#3B7DBF"/>
  <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
  <SolidColorBrush x:Key="Ink" Color="#1F2937"/>
  <SolidColorBrush x:Key="CardBorder" Color="#E3E7EB"/>
  <SolidColorBrush x:Key="CardFill" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelFill" Color="#F5F7FA"/>
  <SolidColorBrush x:Key="GridLine" Color="#EDF0F3"/>

  <!-- Status accents. Used for badges and column headers only; stored data is untouched. -->
  <SolidColorBrush x:Key="StatusViewedBg" Color="#EEF1F4"/>
  <SolidColorBrush x:Key="StatusViewedFg" Color="#4B5563"/>
  <SolidColorBrush x:Key="StatusReadyBg" Color="#E1EEFA"/>
  <SolidColorBrush x:Key="StatusReadyFg" Color="#1D6FB8"/>
  <SolidColorBrush x:Key="StatusAppliedBg" Color="#E4F4E8"/>
  <SolidColorBrush x:Key="StatusAppliedFg" Color="#1E7E34"/>
  <SolidColorBrush x:Key="StatusInterviewBg" Color="#FDF0DF"/>
  <SolidColorBrush x:Key="StatusInterviewFg" Color="#B5660A"/>
  <SolidColorBrush x:Key="StatusDoneBg" Color="#EDE6F8"/>
  <SolidColorBrush x:Key="StatusDoneFg" Color="#6B3FA0"/>

  <!-- Status icons, drawn as plain vector paths on a 16x16 grid. No icon library. -->
  <StreamGeometry x:Key="IconViewed">M1,8 C3,4.5 5.4,3 8,3 C10.6,3 13,4.5 15,8 C13,11.5 10.6,13 8,13 C5.4,13 3,11.5 1,8 Z M8,10.6 A2.6,2.6 0 1,0 8,5.4 A2.6,2.6 0 1,0 8,10.6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconReady">M3,1 L9.4,1 L13,4.6 L13,15 L3,15 Z M5.2,8.6 L7.1,10.5 L10.7,6.9 L11.9,8.1 L7.1,12.9 L4,9.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconApplied">M0.8,7.8 L15.2,1.6 L10.9,15.2 L8,10.3 L12.6,4.3 L6.6,8.9 Z</StreamGeometry>
  <StreamGeometry x:Key="IconInterview">M1.6,2 L14.4,2 L14.4,11 L7.6,11 L4,14.8 L4,11 L1.6,11 Z M4.4,5 L11.6,5 L11.6,6.2 L4.4,6.2 Z M4.4,7.6 L9.4,7.6 L9.4,8.8 L4.4,8.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconDone">M8,0.8 A7.2,7.2 0 1,0 8.01,0.8 Z M7,11.8 L3.3,8.1 L4.7,6.7 L7,9 L11.3,4.7 L12.7,6.1 Z</StreamGeometry>

  <!-- The badge icon: one Path recoloured and reshaped by the bound status. -->
  <Style x:Key="StatusIconStyle" TargetType="Path">
   <Setter Property="Width" Value="11"/>
   <Setter Property="Height" Value="11"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
   <Setter Property="Data" Value="{StaticResource IconViewed}"/>
   <Setter Property="Fill" Value="{StaticResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Ready">
     <Setter Property="Data" Value="{StaticResource IconReady}"/>
     <Setter Property="Fill" Value="{StaticResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Applied">
     <Setter Property="Data" Value="{StaticResource IconApplied}"/>
     <Setter Property="Fill" Value="{StaticResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Interview">
     <Setter Property="Data" Value="{StaticResource IconInterview}"/>
     <Setter Property="Fill" Value="{StaticResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Done">
     <Setter Property="Data" Value="{StaticResource IconDone}"/>
     <Setter Property="Fill" Value="{StaticResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="DashboardCardStyle" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource CardFill}"/>
   <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="14,12"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="CardLabelStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="CardValueStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="28"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="{StaticResource Accent}"/>
   <Setter Property="Margin" Value="0,4,0,2"/>
  </Style>
  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="10.5"/>
  </Style>
  <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,18"/>
  </Style>

  <!-- One pill, recoloured per status by the bound value. -->
  <Style x:Key="StatusBadgeStyle" TargetType="Border">
   <Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="9,2"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="Background" Value="{StaticResource StatusViewedBg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Ready">
     <Setter Property="Background" Value="{StaticResource StatusReadyBg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Applied">
     <Setter Property="Background" Value="{StaticResource StatusAppliedBg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Interview">
     <Setter Property="Background" Value="{StaticResource StatusInterviewBg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Done">
     <Setter Property="Background" Value="{StaticResource StatusDoneBg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="10.5"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{StaticResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Ready">
     <Setter Property="Foreground" Value="{StaticResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Applied">
     <Setter Property="Foreground" Value="{StaticResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Interview">
     <Setter Property="Foreground" Value="{StaticResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Done">
     <Setter Property="Foreground" Value="{StaticResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <!-- Dropdown items are bound to the status STRING, not to a JobTask, so these triggers bind to the
       item itself. Reusing the row badge's styles here would silently render nothing. -->
  <Style x:Key="StatusChoiceIconStyle" TargetType="Path">
   <Setter Property="Width" Value="12"/>
   <Setter Property="Height" Value="12"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Data" Value="{StaticResource IconViewed}"/>
   <Setter Property="Fill" Value="{StaticResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding}" Value="Ready">
     <Setter Property="Data" Value="{StaticResource IconReady}"/>
     <Setter Property="Fill" Value="{StaticResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Applied">
     <Setter Property="Data" Value="{StaticResource IconApplied}"/>
     <Setter Property="Fill" Value="{StaticResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Interview">
     <Setter Property="Data" Value="{StaticResource IconInterview}"/>
     <Setter Property="Fill" Value="{StaticResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Done">
     <Setter Property="Data" Value="{StaticResource IconDone}"/>
     <Setter Property="Fill" Value="{StaticResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StatusChoiceTextStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="{StaticResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding}" Value="Ready">
     <Setter Property="Foreground" Value="{StaticResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Applied">
     <Setter Property="Foreground" Value="{StaticResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Interview">
     <Setter Property="Foreground" Value="{StaticResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Done">
     <Setter Property="Foreground" Value="{StaticResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <!--
    The row's status control. Closed it is the coloured badge; open it is a small list of the five
    statuses with their icons. It is fully templated on purpose: the previous version laid a
    near-transparent ComboBox over the badge, and Opacity/Foreground are INHERITED by the dropdown,
    so the popup rendered five invisible rows — the blank white rectangle.
  -->
  <Style x:Key="StatusPickerStyle" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="MaxDropDownHeight" Value="196"/>
   <Setter Property="ToolTip" Value="Change status"/>
   <Setter Property="ItemContainerStyle">
    <Setter.Value>
     <Style TargetType="ComboBoxItem">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
     </Style>
    </Setter.Value>
   </Setter>
   <Setter Property="ItemTemplate">
    <Setter.Value>
     <DataTemplate>
      <StackPanel Orientation="Horizontal" Background="Transparent">
       <Path Style="{StaticResource StatusChoiceIconStyle}"/>
       <TextBlock Text="{Binding}" Style="{StaticResource StatusChoiceTextStyle}"/>
      </StackPanel>
     </DataTemplate>
    </Setter.Value>
   </Setter>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid Background="Transparent">
       <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch"
                     IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <!-- Transparent background so the whole cell is clickable, not only the badge. -->
          <Border Background="Transparent" Padding="0,2">
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border Style="{StaticResource StatusBadgeStyle}">
             <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource StatusIconStyle}"/>
              <TextBlock Text="{Binding ApplicationStatus}" Style="{StaticResource StatusBadgeTextStyle}"/>
             </StackPanel>
            </Border>
            <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource Muted}" VerticalAlignment="Center"
                  Margin="6,2,0,0"/>
           </StackPanel>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>

       <Popup x:Name="Dropdown" Placement="Bottom" AllowsTransparency="True" Focusable="False"
              PopupAnimation="Fade" StaysOpen="False"
              IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <!-- Sized here, so the popup never inherits the width of the cell or the grid. -->
        <Border Width="158" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,10,10"
                Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="6" Padding="3">
         <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#4A5568"/></Border.Effect>
         <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="FilterControlStyle" TargetType="ComboBox">
   <Setter Property="Height" Value="26"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="11.5"/>
  </Style>

  <Style x:Key="BoardCardStyle" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource CardFill}"/>
   <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <!-- List | Board, drawn as one segmented control. -->
  <Style x:Key="SegmentToggleStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="Padding" Value="16,3"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Chip" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="{StaticResource CardFill}"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <x:Array x:Key="StatusChoices" Type="sys:String">
   <sys:String>Viewed</sys:String>
   <sys:String>Ready</sys:String>
   <sys:String>Applied</sys:String>
   <sys:String>Interview</sys:String>
   <sys:String>Done</sys:String>
  </x:Array>
 </Window.Resources>
 <Grid Margin="14"><TabControl>
  <TabItem Header="General"><ScrollViewer><StackPanel Margin="12">
   <TextBlock Text="Original Resume (DOCX/PDF — used later for document output/template)"/>
<DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="Browse" Click="ResumeBrowse_Click"/><TextBox x:Name="ResumeBox"/></DockPanel>
<TextBlock Text="Baseline Profile"/>
<StackPanel Orientation="Horizontal" Margin="0,4,0,10">
<Button Content="Import Original Resume" Padding="10,4" Click="ImportBaseline_Click"/>
<Button Content="Prepare Profile Creation" Padding="10,4" Margin="8,0,0,0" Click="PrepareProfileCreation_Click"/>
<TextBlock x:Name="BaselineStatus" Margin="12,5,0,0" Text="Not imported"/>
</StackPanel>
   <TextBlock Text="Master Prompt"/><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="Browse" Click="PromptBrowse_Click"/><TextBox x:Name="PromptBox"/></DockPanel>
   <TextBlock Text="Incoming Folder"/><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="Browse" Click="IncomingBrowse_Click"/><TextBox x:Name="IncomingBox"/></DockPanel>
   <TextBlock Text="Imported Folder"/><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="Browse" Click="ImportedBrowse_Click"/><TextBox x:Name="ImportedBox"/></DockPanel>
   <TextBlock Text="Resume Root Folder"/><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="Browse" Click="RootBrowse_Click"/><TextBox x:Name="RootBox"/></DockPanel>
   <StackPanel Orientation="Horizontal"><CheckBox x:Name="DocxBox" Content="DOCX" Margin="0,0,20,0"/><CheckBox x:Name="PdfBox" Content="PDF"/></StackPanel>
   <TextBlock Text="AI Round-Trip Automation" FontWeight="Bold" Margin="0,16,0,4"/>
   <CheckBox x:Name="AutoFillBox" Content="Type the prepared request into the ChatGPT box automatically (you still press Enter)" Margin="0,2,0,0"/>
   <CheckBox x:Name="AutoSendBox" Content="Click ChatGPT's Send button automatically after the prompt is typed in" Margin="0,6,0,0"/>
   <CheckBox x:Name="AutoCaptureBox" Content="Capture the AI answer from the clipboard while a request is waiting" Margin="0,6,0,0"/>
   <TextBlock Text="When the answer is ready" FontWeight="SemiBold" Margin="0,10,0,2"/>
   <CheckBox x:Name="ReadyToastBox" Content="Show a notification on the right side of the screen" Margin="0,2,0,0"/>
   <CheckBox x:Name="ReadySoundBox" Content="Play a sound" Margin="0,6,0,0"/>
   <CheckBox x:Name="ReadyFlashBox" Content="Flash the taskbar button when Resume Builder is in the background" Margin="0,6,0,0"/>
   <CheckBox x:Name="FocusHotkeyBox" Content="Ctrl+Shift+' brings Resume Builder to the front from any app (applies after restart)" Margin="0,6,0,0"/>
   <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0" Text="Resume Builder only watches whether ChatGPT is still generating. You copy the answer yourself: press Ctrl+Shift+' (or click the notification), then press Ctrl+Shift+; to copy the answer's code block (or click the Copy button on that code block)."/>
   <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0" Text="Copying the answer stays manual on purpose: you click ChatGPT's own Copy button and the result is captured from the clipboard. Capture is armed only between sending a request and receiving its answer. Text that is not a candidate profile is ignored and never stored. Tailored results are saved to results\&lt;jobId&gt;.json; candidate-profile.json stays the baseline."/>
   <Button Content="Save" Width="100" Height="34" HorizontalAlignment="Right" Margin="0,18,0,0" Click="Save_Click"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Job Details"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal"><TextBlock Text="Prepared GPT Input (latest)" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/><Button Content="Copy Prepared Input" Margin="16,0,0,0" Padding="10,4" Click="CopyPrepared_Click"/></StackPanel>
<TextBox Grid.Row="1" x:Name="PreparedInputBox" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
</Grid></TabItem>
  <TabItem Header="Result">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<StackPanel Margin="20">
<TextBlock Text="ChatGPT Result Capture" FontWeight="Bold" FontSize="16"/>
<TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Text="Paste the profile JSON returned by ChatGPT here. Validate + Save normalizes known output variations (skills as an object, bullets, dates, institution, start_date/end_date, Markdown contact links, extra fields) into the canonical schema, then validates and saves it."/>
<TextBox x:Name="ResultInputBox" Height="360" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
<Button Content="Paste from Clipboard" Padding="12,5" Click="PasteResult_Click"/>
<Button Content="Validate + Save Profile" Padding="12,5" Margin="8,0,0,0" Click="SaveProfile_Click"/>
</StackPanel>
<TextBlock x:Name="ProfileStatus" Margin="0,10,0,0" TextWrapping="Wrap"/>
</StackPanel>
</ScrollViewer>
</TabItem>
  <TabItem Header="Applications">
<Grid Background="{StaticResource PanelFill}">
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
<StackPanel Margin="14,12,14,14">

<!-- ===== heading ===== -->
<DockPanel Margin="2,0,2,10">
<TextBlock Text="APPLICATIONS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
<Button DockPanel.Dock="Right" Content="Refresh" Padding="12,3" FontSize="11.5" HorizontalAlignment="Right" Click="TrackingRefresh_Click"/>
</DockPanel>

<!-- ===== summary cards ===== -->
<UniformGrid Columns="3" Rows="1">
<Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,5,0">
<StackPanel>
<TextBlock Text="Today's Applications" Style="{StaticResource CardLabelStyle}"/>
<TextBlock x:Name="TodayCountText" Text="0" Style="{StaticResource CardValueStyle}"/>
<TextBlock x:Name="TodayHintText" Text="Marked Applied today" Style="{StaticResource MutedTextStyle}"/>
</StackPanel>
</Border>
<Border Style="{StaticResource DashboardCardStyle}" Margin="5,0">
<StackPanel>
<TextBlock Text="Last 30 Days" Style="{StaticResource CardLabelStyle}"/>
<TextBlock x:Name="MonthCountText" Text="0" Style="{StaticResource CardValueStyle}"/>
<TextBlock x:Name="MonthHintText" Text="Applications submitted" Style="{StaticResource MutedTextStyle}"/>
</StackPanel>
</Border>
<Border Style="{StaticResource DashboardCardStyle}" Margin="5,0,0,0">
<StackPanel>
<TextBlock Text="Total Applications" Style="{StaticResource CardLabelStyle}"/>
<TextBlock x:Name="TotalCountText" Text="0" Style="{StaticResource CardValueStyle}"/>
<TextBlock Text="Applied, Interview and Done" Style="{StaticResource MutedTextStyle}"/>
</StackPanel>
</Border>
</UniformGrid>

<!-- ===== pipeline flow graph (Board mode) ===== -->
<Border x:Name="FlowCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Visibility="Collapsed">
<StackPanel>
<TextBlock Text="Application Flow" Style="{StaticResource SectionHeaderStyle}"/>
<Grid Height="186">
<Canvas x:Name="FlowCanvas" ClipToBounds="True"/>
<TextBlock x:Name="FlowEmptyText" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
           Text="No jobs to chart yet."/>
</Grid>
</StackPanel>
</Border>

<!-- ===== activity chart (List mode) ===== -->
<Border x:Name="ActivityCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0">
<StackPanel>
<DockPanel>
<TextBlock Text="Application Activity" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
<ComboBox x:Name="ActivityRangeBox" DockPanel.Dock="Right" Width="104" Margin="0,0,0,10"
          HorizontalAlignment="Right" Style="{StaticResource FilterControlStyle}"
          SelectionChanged="TrackingFilter_Changed"/>
</DockPanel>

<Grid x:Name="ActivityArea" Height="152">
<!-- guide lines sit behind the bars, across the plot area only -->
<Grid x:Name="ActivityGuides" Margin="34,14,0,22">
<Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<Border Grid.Row="0" BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
<Border Grid.Row="1" BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
<Border Grid.Row="2" BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
<Border Grid.Row="3" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,1"/>
</Grid>

<!-- y axis: peak and zero only, so the scale reads without clutter -->
<StackPanel Width="30" HorizontalAlignment="Left" Margin="0,8,0,16">
<TextBlock x:Name="ActivityPeakText" Text="0" Style="{StaticResource MutedTextStyle}" FontSize="9.5" HorizontalAlignment="Right"/>
<TextBlock Text="0" Style="{StaticResource MutedTextStyle}" FontSize="9.5" HorizontalAlignment="Right"
           VerticalAlignment="Bottom" Margin="0,96,0,0"/>
</StackPanel>

<ItemsControl x:Name="ActivityChart" Margin="36,0,0,0" VerticalAlignment="Stretch">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<!-- The whole column is the hover target, not just the coloured bar: a one-application day is a
     two-pixel bar, which is impossible to point at. -->
<Border Width="{Binding Width}" Margin="{Binding Gap}" Background="Transparent" VerticalAlignment="Stretch"
        ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="15000"
        ToolTipService.BetweenShowDelay="0">
<StackPanel VerticalAlignment="Bottom">
<TextBlock Text="{Binding CountLabel}" FontSize="9.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Height="14"/>
<Border Height="{Binding BarHeight}" Background="{Binding BarBrush}" CornerRadius="3,3,0,0"/>
<TextBlock Text="{Binding Label}" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
           Margin="0,4,0,0" Height="18" TextTrimming="CharacterEllipsis"/>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>

<TextBlock x:Name="ActivityEmptyText" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
           Text="No activity in this date range."/>
</Grid>
</StackPanel>
</Border>

<!-- ===== pipeline ===== -->
<Border Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0">
<StackPanel>
<TextBlock x:Name="PipelineHeader" Text="Pipeline" Style="{StaticResource SectionHeaderStyle}"/>
<ItemsControl x:Name="PipelineView" HorizontalAlignment="Center">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal">
<Border Background="{Binding Background}" CornerRadius="7" Padding="16,8" MinWidth="112" ToolTip="{Binding Tooltip}">
<StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
<Path Data="{Binding Icon}" Fill="{Binding Foreground}" Width="11" Height="11" Stretch="Uniform"
      VerticalAlignment="Center" Margin="0,0,5,0"/>
<TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Foreground}"
           HorizontalAlignment="Center"/>
</StackPanel>
<TextBlock Text="{Binding Count}" FontSize="20" FontWeight="Bold" Foreground="{Binding Foreground}"
           HorizontalAlignment="Center" Margin="0,1,0,0"/>
<TextBlock Text="{Binding Conversion}" FontSize="9.5" Foreground="{Binding Foreground}" Opacity="0.75"
           HorizontalAlignment="Center" Visibility="{Binding ConversionVisibility}"/>
</StackPanel>
</Border>
<TextBlock Text="→" FontSize="15" Foreground="#C3CAD2" VerticalAlignment="Center" Margin="7,0"
           Visibility="{Binding ArrowVisibility}"/>
</StackPanel>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<Border Background="{StaticResource GridLine}" Height="1" Margin="0,12,0,9"/>
<TextBlock x:Name="TrackingCountsText" FontSize="11" Foreground="{StaticResource Ink}" Text="Total jobs: 0"/>
<TextBlock x:Name="TrackingRatesText" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource Muted}"
           Text="Applied rate: 0%"/>
</StackPanel>
</Border>

<!-- ===== toolbar ===== -->
<Border Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Padding="10,8">
<DockPanel>
<Border DockPanel.Dock="Right" Background="{StaticResource PanelFill}" CornerRadius="6" Padding="2" Margin="12,0,0,0">
<StackPanel Orientation="Horizontal">
<RadioButton x:Name="ListToggle" Content="List" GroupName="TrackingView" Style="{StaticResource SegmentToggleStyle}"
             Checked="TrackingListView_Click"/>
<RadioButton x:Name="BoardToggle" Content="Board" GroupName="TrackingView" Style="{StaticResource SegmentToggleStyle}"
             Checked="TrackingBoardView_Click"/>
</StackPanel>
</Border>
<Grid DockPanel.Dock="Right" Margin="8,0,0,0">
<ToggleButton x:Name="DateFilterButton" Width="132" Height="26" FontSize="11.5" HorizontalContentAlignment="Left"
              Padding="8,0" Content="Any date" Click="DateFilterButton_Click"/>
<Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
      Margin="0,0,8,0" IsHitTestVisible="False"/>
<Popup x:Name="DateFilterPopup" PlacementTarget="{Binding ElementName=DateFilterButton}" Placement="Bottom"
       StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-90" Closed="DateFilterPopup_Closed">
<Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
        CornerRadius="8" Padding="4" Margin="0,4,8,8">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#4A5568"/></Border.Effect>
<StackPanel Orientation="Horizontal">
<ListBox x:Name="QuickDateList" Width="120" BorderThickness="0" Background="Transparent" FontSize="11.5"
         Margin="4,6,4,6" SelectionChanged="QuickDate_Changed">
<ListBox.ItemContainerStyle>
<Style TargetType="ListBoxItem">
<Setter Property="Padding" Value="9,6"/>
<Setter Property="Margin" Value="0,1"/>
</Style>
</ListBox.ItemContainerStyle>
</ListBox>
<Border Width="1" Background="{StaticResource GridLine}" Margin="0,8"/>
<Calendar x:Name="DateFilterCalendar" Margin="4,2" SelectedDatesChanged="DateFilterCalendar_Changed"/>
</StackPanel>
</Border>
</Popup>
</Grid>
<ComboBox DockPanel.Dock="Right" x:Name="TrackingFilterBox" Width="104" Margin="8,0,0,0"
          Style="{StaticResource FilterControlStyle}" SelectionChanged="TrackingFilter_Changed"/>
<!-- Platforms: multi-select, OR matching. Built like the date filter; the checkboxes are added in code
     in JobTracker.PlatformFilterOrder. The selection lives only in this window. -->
<Grid DockPanel.Dock="Right" Margin="8,0,0,0">
<ToggleButton x:Name="PlatformFilterButton" Width="132" Height="26" FontSize="11.5" HorizontalContentAlignment="Left"
              Padding="8,0" Content="All platforms" Click="PlatformFilterButton_Click"
              ToolTip="Show jobs from any of the ticked application platforms"/>
<Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
      Margin="0,0,8,0" IsHitTestVisible="False"/>
<Popup x:Name="PlatformFilterPopup" PlacementTarget="{Binding ElementName=PlatformFilterButton}" Placement="Bottom"
       StaysOpen="False" AllowsTransparency="True" Closed="PlatformFilterPopup_Closed">
<Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
        CornerRadius="8" Padding="10,8" Margin="0,4,8,8" MinWidth="160">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#4A5568"/></Border.Effect>
<StackPanel>
<StackPanel x:Name="PlatformCheckList"/>
<Border Height="1" Background="{StaticResource GridLine}" Margin="0,6,0,4"/>
<Button x:Name="PlatformClearButton" Content="Clear" HorizontalAlignment="Left" Padding="2,1" FontSize="11.5"
        Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentSoft}" Cursor="Hand"
        Click="PlatformClear_Click"/>
</StackPanel>
</Border>
</Popup>
</Grid>
<Grid>
<TextBox x:Name="TrackingSearchBox" Height="26" VerticalContentAlignment="Center" Padding="8,0" FontSize="11.5"
         TextChanged="TrackingSearch_Changed"/>
<TextBlock Text="Search applications..." Foreground="#9AA3AE" FontSize="11.5" Margin="11,0,0,0"
           IsHitTestVisible="False" VerticalAlignment="Center">
<TextBlock.Style>
<Style TargetType="TextBlock">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding Text, ElementName=TrackingSearchBox}" Value="">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</TextBlock.Style>
</TextBlock>
</Grid>
</DockPanel>
</Border>

<!-- ===== list view ===== -->
<Border x:Name="ListViewCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Padding="0">
<Grid>
<DataGrid x:Name="TrackingGrid" MaxHeight="320" AutoGenerateColumns="False" IsReadOnly="False"
          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" FontSize="11.5"
          BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#FBFCFD"
          RowHeight="34" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
          MouseDoubleClick="TrackingGrid_DoubleClick" PreviewMouseRightButtonDown="TrackingGrid_RightButtonDown"
          SizeChanged="TrackingGrid_SizeChanged"
          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
<DataGrid.Resources>
<Style TargetType="DataGridColumnHeader">
<Setter Property="Background" Value="{StaticResource PanelFill}"/>
<Setter Property="Foreground" Value="{StaticResource Muted}"/>
<Setter Property="FontSize" Value="10.5"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Padding" Value="10,7"/>
<Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
<Setter Property="BorderThickness" Value="0,0,0,1"/>
<Setter Property="HorizontalContentAlignment" Value="Left"/>
</Style>
<Style TargetType="DataGridCell">
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Padding" Value="10,0"/>
<Setter Property="VerticalContentAlignment" Value="Center"/>
<Style.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Background" Value="#E8EFF7"/>
<Setter Property="Foreground" Value="{StaticResource Ink}"/>
</Trigger>
</Style.Triggers>
</Style>
</DataGrid.Resources>
<DataGrid.ContextMenu>
<ContextMenu>
<MenuItem Header="Open Job Posting" Click="TrackingOpenUrl_Click"/>
<MenuItem Header="Open Resume" Click="TrackingOpenResume_Click"/>
<MenuItem Header="Open Resume Folder" Click="TrackingOpenResumeFolder_Click"/>
<Separator/>
<MenuItem Header="Viewed" Tag="Viewed" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Ready" Tag="Ready" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Applied" Tag="Applied" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Interview" Tag="Interview" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Done" Tag="Done" Click="TrackingSetStatus_Click"/>
</ContextMenu>
</DataGrid.ContextMenu>
<DataGrid.Columns>
<DataGridTemplateColumn Header="Job" Width="2*" MinWidth="150" MaxWidth="420">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="1.3*" MinWidth="110" MaxWidth="280" IsReadOnly="True">
<DataGridTextColumn.ElementStyle>
<Style TargetType="TextBlock">
<Setter Property="VerticalAlignment" Value="Center"/>
<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
</Style>
</DataGridTextColumn.ElementStyle>
</DataGridTextColumn>
<DataGridTemplateColumn Header="Status" Width="140" MinWidth="140">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<ComboBox x:Name="StatusPicker" Style="{StaticResource StatusPickerStyle}"
          ItemsSource="{StaticResource StatusChoices}"
          SelectedItem="{Binding ApplicationStatus, Mode=OneWay}"
          SelectionChanged="TrackingStatusBox_Changed"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="Resume" Width="116" MinWidth="116">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding ResumeStateDisplay}" VerticalAlignment="Center" FontSize="11"
           Foreground="{StaticResource Muted}"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Date" Binding="{Binding TrackingDateDisplay}" Width="88" MinWidth="88" IsReadOnly="True">
<DataGridTextColumn.ElementStyle>
<Style TargetType="TextBlock">
<Setter Property="VerticalAlignment" Value="Center"/>
<Setter Property="Foreground" Value="{StaticResource Muted}"/>
</Style>
</DataGridTextColumn.ElementStyle>
</DataGridTextColumn>
<DataGridTemplateColumn Header="Actions" Width="196" MinWidth="196">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<Button Content="Open Job" Padding="8,2" FontSize="10.5" Click="TrackingOpenUrl_Click"
        ToolTip="Open the job posting in your browser"/>
<Button Content="Resume" Padding="8,2" FontSize="10.5" Margin="5,0,0,0" Click="TrackingOpenResume_Click"
        IsEnabled="{Binding ResumeGenerated}" ToolTip="Open the generated DOCX"/>
<Button Content="Folder" Padding="8,2" FontSize="10.5" Margin="5,0,0,0" Click="TrackingOpenResumeFolder_Click"
        IsEnabled="{Binding ResumeGenerated}" ToolTip="Open the folder the resume was written to"/>
</StackPanel>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
</DataGrid>
<TextBlock x:Name="ListEmptyText" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
           Text="No applications found."/>
</Grid>
</Border>

<!-- ===== board view ===== -->
<Border x:Name="BoardViewCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Visibility="Collapsed">
<ItemsControl x:Name="BoardView">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Background="{StaticResource PanelFill}" CornerRadius="7" Margin="3,0" Padding="7,7,7,3">
<StackPanel>
<DockPanel Margin="1,0,1,7">
<Path Data="{Binding Icon}" Fill="{Binding Foreground}" Width="11" Height="11" Stretch="Uniform"
      VerticalAlignment="Center" Margin="0,0,5,0"/>
<TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding Foreground}"
           VerticalAlignment="Center"/>
<Border DockPanel.Dock="Right" Background="{Binding Background}" CornerRadius="8" Padding="7,1"
        HorizontalAlignment="Right">
<TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Foreground}"/>
</Border>
</DockPanel>
<ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
<StackPanel>
<ItemsControl ItemsSource="{Binding Jobs}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource BoardCardStyle}">
<Border.ContextMenu>
<ContextMenu>
<MenuItem Header="Open Job Posting" Click="TrackingOpenUrl_Click"/>
<MenuItem Header="Open Resume" Click="TrackingOpenResume_Click"/>
<MenuItem Header="Open Resume Folder" Click="TrackingOpenResumeFolder_Click"/>
<Separator/>
<MenuItem Header="Viewed" Tag="Viewed" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Ready" Tag="Ready" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Applied" Tag="Applied" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Interview" Tag="Interview" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Done" Tag="Done" Click="TrackingSetStatus_Click"/>
</ContextMenu>
</Border.ContextMenu>
<StackPanel>
<StackPanel Orientation="Horizontal">
<Path Style="{StaticResource StatusIconStyle}" Width="10" Height="10" Margin="0,0,4,0"/>
<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Ink}"
           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
</StackPanel>
<TextBlock Text="{Binding Company}" FontSize="10" Foreground="{StaticResource Muted}"
           TextTrimming="CharacterEllipsis"/>
<DockPanel Margin="0,5,0,0">
<TextBlock Text="{Binding TrackingDateDisplay}" FontSize="9.5" Foreground="{StaticResource Muted}"/>
<TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="9.5"
           Foreground="{StaticResource AccentSoft}"
           Text="{Binding ResumeStateDisplay, StringFormat=Resume: {0}}"/>
</DockPanel>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<TextBlock Text="Nothing here" Foreground="#A8B0BA" FontSize="10" HorizontalAlignment="Center"
           Margin="0,10,0,12" Visibility="{Binding EmptyVisibility}"/>
</StackPanel>
</ScrollViewer>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Border>

<TextBlock x:Name="TrackingStatus" Margin="2,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"
           Text="Double-click a row to open the job posting. Right-click a row or card for status and resume actions. Resume Builder only sets Ready by itself, when a resume has been generated."/>
</StackPanel>
</ScrollViewer>
</Grid>
</TabItem>
  <TabItem Header="Development"><StackPanel Margin="16">
<TextBlock Text="Sample Input" FontWeight="Bold" FontSize="16"/>
<TextBlock Margin="0,8,0,12" Text="Writes one job file per job to Incoming — { company, title, jobUrl, companyUrl, description } — and uses the normal importer." TextWrapping="Wrap"/>
<StackPanel Orientation="Horizontal">
<Button Content="Load Sample Jobs" Width="160" Height="34" HorizontalAlignment="Left" Click="LoadSampleJobs_Click"/>
<Button Content="Load 50 Sample Jobs" Width="170" Height="34" Margin="10,0,0,0" HorizontalAlignment="Left" Click="LoadStressJobs_Click"/>
</StackPanel>
<TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#666" Text="&quot;Load 50 Sample Jobs&quot; writes 50 synthetic jobs (invented companies and descriptions) to the Incoming folder for queue stress testing. Nothing is written until you click it."/>
<TextBlock Margin="0,18,0,4" Text="Test Data" FontWeight="Bold"/>
<TextBlock Text="Google — Senior Software Engineer&#10;Stripe — Backend Engineer&#10;Amazon — Software Engineer II"/>
<Button Content="Clear Test Queue" Width="160" Height="34" HorizontalAlignment="Left" Margin="0,18,0,0" Click="ClearTestQueue_Click"/>
</StackPanel></TabItem>
 </TabControl></Grid>
</Window>
