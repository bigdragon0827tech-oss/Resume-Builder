<UserControl x:Class="ResumeBuilder.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 xmlns:local="clr-namespace:ResumeBuilder">
 <UserControl.Resources>
  <!-- Colours come from Themes/Theme.xaml (Accent, Status*, Card*, PanelFill, …). -->
  <!-- Status icons, drawn as plain vector paths on a 16x16 grid. No icon library. -->
  <StreamGeometry x:Key="IconViewed">M1,8 C3,4.5 5.4,3 8,3 C10.6,3 13,4.5 15,8 C13,11.5 10.6,13 8,13 C5.4,13 3,11.5 1,8 Z M8,10.6 A2.6,2.6 0 1,0 8,5.4 A2.6,2.6 0 1,0 8,10.6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconReady">M3,1 L9.4,1 L13,4.6 L13,15 L3,15 Z M5.2,8.6 L7.1,10.5 L10.7,6.9 L11.9,8.1 L7.1,12.9 L4,9.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconApplied">M0.8,7.8 L15.2,1.6 L10.9,15.2 L8,10.3 L12.6,4.3 L6.6,8.9 Z</StreamGeometry>
  <StreamGeometry x:Key="IconInterview">M1.6,2 L14.4,2 L14.4,11 L7.6,11 L4,14.8 L4,11 L1.6,11 Z M4.4,5 L11.6,5 L11.6,6.2 L4.4,6.2 Z M4.4,7.6 L9.4,7.6 L9.4,8.8 L4.4,8.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconDone">M8,0.8 A7.2,7.2 0 1,0 8.01,0.8 Z M7,11.8 L3.3,8.1 L4.7,6.7 L7,9 L11.3,4.7 L12.7,6.1 Z</StreamGeometry>

  <!-- The badge icon: one Path recoloured and reshaped by the bound status. -->
  <Style x:Key="StatusIconStyle" TargetType="Path">
   <Setter Property="Width" Value="11"/>
   <Setter Property="Height" Value="11"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
   <Setter Property="Data" Value="{StaticResource IconViewed}"/>
   <Setter Property="Fill" Value="{DynamicResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Ready">
     <Setter Property="Data" Value="{StaticResource IconReady}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Applied">
     <Setter Property="Data" Value="{StaticResource IconApplied}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Interview">
     <Setter Property="Data" Value="{StaticResource IconInterview}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Done">
     <Setter Property="Data" Value="{StaticResource IconDone}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="DashboardCardStyle" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="14,12"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="CardLabelStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="CardValueStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="28"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="{DynamicResource Accent.Default}"/>
   <Setter Property="Margin" Value="0,4,0,2"/>
  </Style>
  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
   <Setter Property="FontSize" Value="10.5"/>
  </Style>
  <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,18"/>
  </Style>

  <!-- One pill, recoloured per status by the bound value. -->
  <Style x:Key="StatusBadgeStyle" TargetType="Border">
   <Setter Property="CornerRadius" Value="10"/>
   <Setter Property="Padding" Value="10,3"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
   <Setter Property="Background" Value="{DynamicResource StatusViewedBg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Ready">
     <Setter Property="Background" Value="{DynamicResource StatusReadyBg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Applied">
     <Setter Property="Background" Value="{DynamicResource StatusAppliedBg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Interview">
     <Setter Property="Background" Value="{DynamicResource StatusInterviewBg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Done">
     <Setter Property="Background" Value="{DynamicResource StatusDoneBg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="10.5"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Ready">
     <Setter Property="Foreground" Value="{DynamicResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Applied">
     <Setter Property="Foreground" Value="{DynamicResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Interview">
     <Setter Property="Foreground" Value="{DynamicResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding ApplicationStatus}" Value="Done">
     <Setter Property="Foreground" Value="{DynamicResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <!-- Dropdown items are bound to the status STRING, not to a JobTask, so these triggers bind to the
       item itself. Reusing the row badge's styles here would silently render nothing. -->
  <Style x:Key="StatusChoiceIconStyle" TargetType="Path">
   <Setter Property="Width" Value="12"/>
   <Setter Property="Height" Value="12"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Data" Value="{StaticResource IconViewed}"/>
   <Setter Property="Fill" Value="{DynamicResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding}" Value="Ready">
     <Setter Property="Data" Value="{StaticResource IconReady}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Applied">
     <Setter Property="Data" Value="{StaticResource IconApplied}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Interview">
     <Setter Property="Data" Value="{StaticResource IconInterview}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Done">
     <Setter Property="Data" Value="{StaticResource IconDone}"/>
     <Setter Property="Fill" Value="{DynamicResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StatusChoiceTextStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="{DynamicResource StatusViewedFg}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding}" Value="Ready">
     <Setter Property="Foreground" Value="{DynamicResource StatusReadyFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Applied">
     <Setter Property="Foreground" Value="{DynamicResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Interview">
     <Setter Property="Foreground" Value="{DynamicResource StatusInterviewFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding}" Value="Done">
     <Setter Property="Foreground" Value="{DynamicResource StatusDoneFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <!--
    The row's status control. Closed it is the coloured badge; open it is a small list of the five
    statuses with their icons. It is fully templated on purpose: the previous version laid a
    near-transparent ComboBox over the badge, and Opacity/Foreground are INHERITED by the dropdown,
    so the popup rendered five invisible rows — the blank white rectangle.
  -->
  <Style x:Key="StatusPickerStyle" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="MaxDropDownHeight" Value="196"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ToolTip" Value="Change status"/>
   <Setter Property="ItemContainerStyle">
    <Setter.Value>
     <Style TargetType="ComboBoxItem">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
         <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True">
           <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
           <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}"/>
          </Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
    </Setter.Value>
   </Setter>
   <Setter Property="ItemTemplate">
    <Setter.Value>
     <DataTemplate>
      <StackPanel Orientation="Horizontal" Background="Transparent">
       <Path Style="{StaticResource StatusChoiceIconStyle}"/>
       <TextBlock Text="{Binding}" Style="{StaticResource StatusChoiceTextStyle}"/>
      </StackPanel>
     </DataTemplate>
    </Setter.Value>
   </Setter>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid Background="Transparent">
       <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch"
                     IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <!-- Transparent background so the whole cell is clickable, not only the badge. -->
          <Border Background="Transparent" Padding="0,2" CornerRadius="6">
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border Style="{StaticResource StatusBadgeStyle}">
             <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource StatusIconStyle}"/>
              <TextBlock Text="{Binding ApplicationStatus}" Style="{StaticResource StatusBadgeTextStyle}"/>
             </StackPanel>
            </Border>
            <Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{DynamicResource Text.Muted}" VerticalAlignment="Center"
                  Margin="6,2,0,0"/>
           </StackPanel>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>

       <Popup x:Name="Dropdown" Placement="Bottom" AllowsTransparency="True" Focusable="False"
              PopupAnimation="Fade" StaysOpen="False"
              IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <!-- Sized here, so the popup never inherits the width of the cell or the grid. -->
        <Border Width="168" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,10,10"
                Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1" CornerRadius="8" Padding="4">
         <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="#1F2937"/></Border.Effect>
         <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="FilterControlStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="Height" Value="28"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="11.5"/>
  </Style>

  <!-- Application platform badge, shared by the List's Job cell and the Board card. Neutral colours on
       purpose, so it never reads as an application status. Text comes from JobTracker.PlatformDisplayName;
       Unknown (no application link recorded) is hidden, and so is its tooltip. Display only. -->
  <local:PlatformDisplayConverter x:Key="PlatformDisplay"/>
  <local:OpenableUrlConverter x:Key="OpenableUrl"/>
  <local:CanMarkAppliedConverter x:Key="CanMarkApplied"/>
  <local:JobDateTextConverter x:Key="JobDateText"/>
  <Style x:Key="PlatformBadgeStyle" TargetType="ContentControl">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="ToolTip" Value="{Binding ApplyUrl}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ContentControl">
      <Border Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
              CornerRadius="10" Padding="7,1,7,2">
       <TextBlock Text="{Binding ApplicationPlatform, Converter={StaticResource PlatformDisplay}}"
                  FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ApplicationPlatform}" Value="{x:Static local:ApplicationPlatform.Unknown}">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Setter Property="ToolTip" Value="{x:Null}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <!-- Application readiness: coloured TEXT (never a badge, so it cannot pass for the Status badge),
       reusing the status foreground brushes. Display only; the value is JobTracker.GetReadiness. -->
  <Style x:Key="ReadinessTextStyle" TargetType="TextBlock">
   <Setter Property="Text" Value="{Binding ReadinessDisplay}"/>
   <Setter Property="ToolTip" Value="{Binding ReadinessHint}"/>
   <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Readiness}" Value="{x:Static local:ApplicationReadiness.ReadyToApply}">
     <Setter Property="Foreground" Value="{DynamicResource StatusAppliedFg}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Readiness}" Value="{x:Static local:ApplicationReadiness.NeedsApplyLink}">
     <Setter Property="Foreground" Value="{DynamicResource StatusInterviewFg}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="BoardCardStyle" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <!-- List | Board, drawn as one segmented control. -->
  <Style x:Key="SegmentToggleStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="Padding" Value="16,3"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Chip" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bg.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent.Default}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bg.Hover}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <x:Array x:Key="StatusChoices" Type="sys:String">
   <sys:String>Viewed</sys:String>
   <sys:String>Ready</sys:String>
   <sys:String>Applied</sys:String>
   <sys:String>Interview</sys:String>
   <sys:String>Done</sys:String>
  </x:Array>
 </UserControl.Resources>

 <Grid Background="{DynamicResource Bg.App}">
  <Grid.ColumnDefinitions>
   <ColumnDefinition x:Name="SectionNavColumn" Width="200"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border x:Name="SectionNavPanel" Grid.Column="0" Background="{DynamicResource Bg.Sidebar}"
          BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Settings" FontWeight="SemiBold" FontSize="13"
               Margin="16,18,16,10" Foreground="{DynamicResource Text.Primary}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="8,0,8,16">
      <RadioButton x:Name="NavCandidateProfile" Content="Candidate Profile" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Candidate Profile" IsChecked="True" Checked="SectionNav_Checked"/>
      <RadioButton Content="Prompts" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Prompts" Checked="SectionNav_Checked"/>
      <RadioButton Content="Folders" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Folders" Checked="SectionNav_Checked"/>
      <RadioButton Content="Document Output" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Document Output" Checked="SectionNav_Checked"/>
      <RadioButton Content="Automation" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Automation" Checked="SectionNav_Checked"/>
      <RadioButton Content="Notifications" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Notifications" Checked="SectionNav_Checked"/>
      <RadioButton Content="Job Details" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Job Details" Checked="SectionNav_Checked"/>
      <RadioButton Content="Manual Result" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Result" Checked="SectionNav_Checked"/>
      <RadioButton Content="Development" GroupName="SettingsSection" Style="{DynamicResource NavButtonStyle}"
                   Tag="Development" Checked="SectionNav_Checked"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <TabControl x:Name="SettingsTabs" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0">
   <TabControl.ItemContainerStyle>
    <Style TargetType="TabItem">
     <Setter Property="Visibility" Value="Collapsed"/>
     <Setter Property="Height" Value="0"/>
    </Style>
   </TabControl.ItemContainerStyle>

  <TabItem Header="Candidate Profile">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="720">
     <TextBlock Text="Candidate Profile" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Text="Original resume and baseline profile used for document output." Style="{DynamicResource PageSubtitleStyle}"/>
     <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="Original Resume (DOCX/PDF)" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <DockPanel Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="ResumeBrowse_Click"/>
        <TextBox x:Name="ResumeBox"/>
       </DockPanel>
       <TextBlock Text="Baseline Profile" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal">
        <Button Content="Import Original Resume" Style="{DynamicResource BtnPrimary}" Click="ImportBaseline_Click"/>
        <Button Content="Prepare Profile Creation" Margin="8,0,0,0" Click="PrepareProfileCreation_Click"/>
        <TextBlock x:Name="BaselineStatus" Margin="12,8,0,0" Foreground="{DynamicResource Text.Secondary}" Text="Not imported"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Button Content="Save settings" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Left" Width="140" Height="34" Click="Save_Click"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="Prompts">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="720">
     <TextBlock Text="Prompts" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Text="Which prompt file is used; the job payload and output contract stay the same." Style="{DynamicResource PageSubtitleStyle}"/>
     <Border Style="{DynamicResource CardStyle}">
      <StackPanel>
       <TextBlock Text="Prompt Mode" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <RadioButton x:Name="ResumeModeBox" GroupName="PromptMode" Content="Resume" Margin="0,0,16,0"
                     Checked="PromptMode_Changed" ToolTip="Use the Master Prompt file below"/>
        <RadioButton x:Name="NormalModeBox" GroupName="PromptMode" Content="Normal"
                     Checked="PromptMode_Changed" ToolTip="Use your own prompt file; Resume Builder still adds the job payload and its output rules"/>
       </StackPanel>
       <TextBlock Text="Master Prompt" Margin="0,0,0,4"/>
       <DockPanel Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="PromptBrowse_Click"/>
        <TextBox x:Name="PromptBox"/>
       </DockPanel>
       <TextBlock Text="Normal Prompt" Margin="0,0,0,4"/>
       <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="NormalPromptBrowse_Click"/>
        <TextBox x:Name="NormalPromptBox"/>
       </DockPanel>
       <TextBlock x:Name="PromptModeHint" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" FontSize="11.5"/>
      </StackPanel>
     </Border>
     <Button Content="Save settings" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Left" Width="140" Height="34" Margin="0,16,0,0" Click="Save_Click"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="Folders">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="720">
     <TextBlock Text="Folders" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Text="Where jobs arrive, where imports are archived, and where resumes are written." Style="{DynamicResource PageSubtitleStyle}"/>
     <Border Style="{DynamicResource CardStyle}">
      <StackPanel>
       <TextBlock Text="Incoming Folder" Margin="0,0,0,4"/>
       <DockPanel Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="IncomingBrowse_Click"/>
        <TextBox x:Name="IncomingBox"/>
       </DockPanel>
       <TextBlock Text="Imported Folder" Margin="0,0,0,4"/>
       <DockPanel Margin="0,0,0,12">
        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="ImportedBrowse_Click"/>
        <TextBox x:Name="ImportedBox"/>
       </DockPanel>
       <TextBlock Text="Resume Root Folder" Margin="0,0,0,4"/>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="RootBrowse_Click"/>
        <TextBox x:Name="RootBox"/>
       </DockPanel>
      </StackPanel>
     </Border>
     <Button Content="Save settings" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Left" Width="140" Height="34" Margin="0,16,0,0" Click="Save_Click"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="Document Output">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="720">
     <TextBlock Text="Document Output" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Text="Which formats are generated after a validated profile is saved." Style="{DynamicResource PageSubtitleStyle}"/>
     <Border Style="{DynamicResource CardStyle}">
      <StackPanel Orientation="Horizontal">
       <CheckBox x:Name="DocxBox" Content="DOCX" Margin="0,0,24,0"/>
       <CheckBox x:Name="PdfBox" Content="PDF"/>
      </StackPanel>
     </Border>
     <Button Content="Save settings" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Left" Width="140" Height="34" Margin="0,16,0,0" Click="Save_Click"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="Automation">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="720">
     <TextBlock Text="Automation" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Text="How Resume Builder talks to ChatGPT. Copying the answer stays clipboard-based." Style="{DynamicResource PageSubtitleStyle}"/>
     <Border Style="{DynamicResource CardStyle}">
      <StackPanel>
       <CheckBox x:Name="AutoFillBox" Content="Type the prepared request into the ChatGPT box automatically (you still press Enter)" Margin="0,2,0,0"/>
       <CheckBox x:Name="AutoSendBox" Content="Click ChatGPT's Send button automatically after the prompt is typed in" Margin="0,10,0,0"/>
       <CheckBox x:Name="AutoCaptureBox" Content="Capture the AI answer from the clipboard while a request is waiting" Margin="0,10,0,0"/>
       <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,14,0,0" FontSize="11.5"
                  Text="Resume Builder only watches whether ChatGPT is still generating. You copy the answer yourself: press Ctrl+Shift+' (or click the notification), then press Ctrl+Shift+; to copy the answer's code block (or click the Copy button on that code block)."/>
       <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,8,0,0" FontSize="11.5"
                  Text="Copying the answer stays manual on purpose: you click ChatGPT's own Copy button and the result is captured from the clipboard. Capture is armed only between sending a request and receiving its answer. Text that is not a candidate profile is ignored and never stored. Tailored results are saved to results\&lt;jobId&gt;.json; candidate-profile.json stays the baseline."/>
      </StackPanel>
     </Border>
     <Button Content="Save settings" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Left" Width="140" Height="34" Margin="0,16,0,0" Click="Save_Click"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="Notifications">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="720">
     <TextBlock Text="Notifications" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Text="What happens when an answer is ready." Style="{DynamicResource PageSubtitleStyle}"/>
     <Border Style="{DynamicResource CardStyle}">
      <StackPanel>
       <CheckBox x:Name="ReadyToastBox" Content="Show a notification on the right side of the screen" Margin="0,2,0,0"/>
       <CheckBox x:Name="ReadySoundBox" Content="Play a sound" Margin="0,10,0,0"/>
       <CheckBox x:Name="ReadyFlashBox" Content="Flash the taskbar button when Resume Builder is in the background" Margin="0,10,0,0"/>
       <CheckBox x:Name="FocusHotkeyBox" Content="Ctrl+Shift+' brings Resume Builder to the front from any app (applies after restart)" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <Button Content="Save settings" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Left" Width="140" Height="34" Margin="0,16,0,0" Click="Save_Click"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="Job Details">
   <Grid Margin="24">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="Job Details" Style="{DynamicResource PageTitleStyle}"/>
     <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Copy Prepared Input" Style="{DynamicResource BtnPrimary}" Click="CopyPrepared_Click"/>
      <TextBlock Text="Prepared GPT input (latest)" Style="{DynamicResource PageSubtitleStyle}" Margin="0"/>
     </DockPanel>
    </StackPanel>
    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="0">
     <TextBox x:Name="PreparedInputBox" Margin="12" IsReadOnly="True" TextWrapping="Wrap"
              Background="Transparent" BorderThickness="0"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
              Foreground="{DynamicResource Text.Primary}"/>
    </Border>
   </Grid>
  </TabItem>

  <TabItem Header="Result">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel>
     <TextBlock Text="Manual Result Capture" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Style="{DynamicResource PageSubtitleStyle}"
                Text="Paste the profile JSON returned by ChatGPT here. Validate + Save normalizes known output variations into the canonical schema, then validates and saves it."/>
     <Border Style="{DynamicResource CardStyle}" Padding="0" Margin="0,0,0,12">
      <TextBox x:Name="ResultInputBox" Height="360" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
               Background="Transparent" BorderThickness="0" Margin="12"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
     </Border>
     <StackPanel Orientation="Horizontal">
      <Button Content="Paste from Clipboard" Click="PasteResult_Click"/>
      <Button Content="Validate + Save Profile" Style="{DynamicResource BtnPrimary}" Margin="8,0,0,0" Click="SaveProfile_Click"/>
     </StackPanel>
     <TextBlock x:Name="ProfileStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

<TabItem Header="Applications">
<Grid Background="{DynamicResource Bg.App}">
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
<StackPanel Margin="24,20,24,24">

<!-- ===== heading ===== -->
<DockPanel Margin="2,0,2,10">
<TextBlock Text="Applications" Style="{DynamicResource PageTitleStyle}" Margin="0" VerticalAlignment="Center"/>
<Button DockPanel.Dock="Right" Content="Refresh" Padding="12,3" FontSize="11.5" HorizontalAlignment="Right" Click="TrackingRefresh_Click"/>
</DockPanel>

<!-- ===== summary cards ===== -->
<UniformGrid Columns="4" Rows="1">
<Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,5,0">
<StackPanel>
<TextBlock Text="Today's Applications" Style="{StaticResource CardLabelStyle}"/>
<TextBlock x:Name="TodayCountText" Text="0" Style="{StaticResource CardValueStyle}"/>
<TextBlock x:Name="TodayHintText" Text="Marked Applied today" Style="{StaticResource MutedTextStyle}"/>
</StackPanel>
</Border>
<Border Style="{StaticResource DashboardCardStyle}" Margin="5,0">
<StackPanel>
<TextBlock Text="Last 30 Days" Style="{StaticResource CardLabelStyle}"/>
<TextBlock x:Name="MonthCountText" Text="0" Style="{StaticResource CardValueStyle}"/>
<TextBlock x:Name="MonthHintText" Text="Applications submitted" Style="{StaticResource MutedTextStyle}"/>
</StackPanel>
</Border>
<Border Style="{StaticResource DashboardCardStyle}" Margin="5,0">
<StackPanel>
<TextBlock Text="Total Applications" Style="{StaticResource CardLabelStyle}"/>
<TextBlock x:Name="TotalCountText" Text="0" Style="{StaticResource CardValueStyle}"/>
<TextBlock Text="Applied, Interview and Done" Style="{StaticResource MutedTextStyle}"/>
</StackPanel>
</Border>
<!-- Ready to apply: the one clickable card. A real Button (focusable, Enter/Space work) drawn with the
     same DashboardCardStyle; it shows exactly the counted jobs (ReadyToApplyCard_Click). -->
<Button x:Name="ReadyToApplyCard" Margin="5,0,0,0" Click="ReadyToApplyCard_Click" Cursor="Hand"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
        ToolTip="Show the jobs ready to apply that you have not marked Applied yet"
        AutomationProperties.Name="Ready to apply">
<Button.Template>
<ControlTemplate TargetType="Button">
<Border x:Name="Card" Style="{StaticResource DashboardCardStyle}">
<ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Hover}"/>
</Trigger>
<Trigger Property="IsKeyboardFocused" Value="True">
<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.Default}"/>
<Setter TargetName="Card" Property="BorderThickness" Value="2"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Button.Template>
<StackPanel>
<TextBlock Text="Ready to apply" Style="{StaticResource CardLabelStyle}"/>
<TextBlock x:Name="ReadyToApplyCountText" Text="0" Style="{StaticResource CardValueStyle}"/>
<TextBlock Text="Ready, not applied yet" Style="{StaticResource MutedTextStyle}"/>
</StackPanel>
</Button>
</UniformGrid>

<!-- ===== pipeline flow graph (Board mode) ===== -->
<Border x:Name="FlowCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Visibility="Collapsed">
<StackPanel>
<TextBlock Text="Application Flow" Style="{StaticResource SectionHeaderStyle}"/>
<Grid Height="186">
<Canvas x:Name="FlowCanvas" ClipToBounds="True"/>
<TextBlock x:Name="FlowEmptyText" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
           Text="No jobs to chart yet."/>
</Grid>
</StackPanel>
</Border>

<!-- ===== activity chart (List mode) ===== -->
<Border x:Name="ActivityCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0">
<StackPanel>
<DockPanel>
<TextBlock Text="Application Activity" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
<ComboBox x:Name="ActivityRangeBox" DockPanel.Dock="Right" Width="104" Margin="0,0,0,10"
          HorizontalAlignment="Right" Style="{StaticResource FilterControlStyle}"
          SelectionChanged="TrackingFilter_Changed"/>
</DockPanel>

<Grid x:Name="ActivityArea" Height="152">
<!-- guide lines sit behind the bars, across the plot area only -->
<Grid x:Name="ActivityGuides" Margin="34,14,0,22">
<Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<Border Grid.Row="0" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
<Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
<Border Grid.Row="2" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
<Border Grid.Row="3" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,1"/>
</Grid>

<!-- y axis: peak and zero only, so the scale reads without clutter -->
<StackPanel Width="30" HorizontalAlignment="Left" Margin="0,8,0,16">
<TextBlock x:Name="ActivityPeakText" Text="0" Style="{StaticResource MutedTextStyle}" FontSize="9.5" HorizontalAlignment="Right"/>
<TextBlock Text="0" Style="{StaticResource MutedTextStyle}" FontSize="9.5" HorizontalAlignment="Right"
           VerticalAlignment="Bottom" Margin="0,96,0,0"/>
</StackPanel>

<ItemsControl x:Name="ActivityChart" Margin="36,0,0,0" VerticalAlignment="Stretch">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<!-- The whole column is the hover target, not just the coloured bar: a one-application day is a
     two-pixel bar, which is impossible to point at. -->
<Border Width="{Binding Width}" Margin="{Binding Gap}" Background="Transparent" VerticalAlignment="Stretch"
        ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="15000"
        ToolTipService.BetweenShowDelay="0">
<StackPanel VerticalAlignment="Bottom">
<TextBlock Text="{Binding CountLabel}" FontSize="9.5" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Height="14"/>
<Border Height="{Binding BarHeight}" Background="{Binding BarBrush}" CornerRadius="3,3,0,0"/>
<TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"
           Margin="0,4,0,0" Height="18" TextTrimming="CharacterEllipsis"/>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>

<TextBlock x:Name="ActivityEmptyText" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
           Text="No activity in this date range."/>
</Grid>
</StackPanel>
</Border>

<!-- ===== pipeline ===== -->
<Border Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0">
<StackPanel>
<TextBlock x:Name="PipelineHeader" Text="Pipeline" Style="{StaticResource SectionHeaderStyle}"/>
<ItemsControl x:Name="PipelineView" HorizontalAlignment="Center">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal">
<Border Background="{Binding Background}" CornerRadius="7" Padding="16,8" MinWidth="112" ToolTip="{Binding Tooltip}">
<StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
<Path Data="{Binding Icon}" Fill="{Binding Foreground}" Width="11" Height="11" Stretch="Uniform"
      VerticalAlignment="Center" Margin="0,0,5,0"/>
<TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Foreground}"
           HorizontalAlignment="Center"/>
</StackPanel>
<TextBlock Text="{Binding Count}" FontSize="20" FontWeight="Bold" Foreground="{Binding Foreground}"
           HorizontalAlignment="Center" Margin="0,1,0,0"/>
<TextBlock Text="{Binding Conversion}" FontSize="9.5" Foreground="{Binding Foreground}" Opacity="0.75"
           HorizontalAlignment="Center" Visibility="{Binding ConversionVisibility}"/>
</StackPanel>
</Border>
<TextBlock Text="→" FontSize="15" Foreground="#C3CAD2" VerticalAlignment="Center" Margin="7,0"
           Visibility="{Binding ArrowVisibility}"/>
</StackPanel>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<Border Background="{DynamicResource Border.Subtle}" Height="1" Margin="0,12,0,9"/>
<TextBlock x:Name="TrackingCountsText" FontSize="11" Foreground="{DynamicResource Text.Primary}" Text="Total jobs: 0"/>
<TextBlock x:Name="TrackingRatesText" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Text.Muted}"
           Text="Applied rate: 0%"/>
</StackPanel>
</Border>

<!-- ===== toolbar ===== -->
<Border Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Padding="10,8">
<DockPanel>
<Border DockPanel.Dock="Right" Background="{DynamicResource Bg.App}" CornerRadius="6" Padding="2" Margin="12,0,0,0">
<StackPanel Orientation="Horizontal">
<RadioButton x:Name="ListToggle" Content="List" GroupName="TrackingView" Style="{StaticResource SegmentToggleStyle}"
             Checked="TrackingListView_Click"/>
<RadioButton x:Name="BoardToggle" Content="Board" GroupName="TrackingView" Style="{StaticResource SegmentToggleStyle}"
             Checked="TrackingBoardView_Click"/>
</StackPanel>
</Border>
<Grid DockPanel.Dock="Right" Margin="8,0,0,0">
<ToggleButton x:Name="DateFilterButton" Width="132" Height="28" FontSize="11.5" HorizontalContentAlignment="Left"
              Padding="8,0" Content="Any date" Click="DateFilterButton_Click"/>
<Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{DynamicResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
      Margin="0,0,8,0" IsHitTestVisible="False"/>
<Popup x:Name="DateFilterPopup" PlacementTarget="{Binding ElementName=DateFilterButton}" Placement="Bottom"
       StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-90" Closed="DateFilterPopup_Closed">
<Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
        CornerRadius="8" Padding="4" Margin="0,4,8,8">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="#000000"/></Border.Effect>
<StackPanel Orientation="Horizontal">
<ListBox x:Name="QuickDateList" Width="120" BorderThickness="0" Background="Transparent" FontSize="11.5"
         Margin="4,6,4,6" SelectionChanged="QuickDate_Changed">
<ListBox.ItemContainerStyle>
<Style TargetType="ListBoxItem">
<Setter Property="Padding" Value="9,6"/>
<Setter Property="Margin" Value="0,1"/>
</Style>
</ListBox.ItemContainerStyle>
</ListBox>
<Border Width="1" Background="{DynamicResource Border.Subtle}" Margin="0,8"/>
<Calendar x:Name="DateFilterCalendar" Margin="4,2" SelectedDatesChanged="DateFilterCalendar_Changed"
          Background="{DynamicResource Bg.Surface}" Foreground="{DynamicResource Text.Primary}"
          BorderBrush="{DynamicResource Border.Subtle}"/>
</StackPanel>
</Border>
</Popup>
</Grid>
<ComboBox DockPanel.Dock="Right" x:Name="TrackingFilterBox" Width="104" Margin="8,0,0,0"
          Style="{StaticResource FilterControlStyle}" SelectionChanged="TrackingFilter_Changed"/>
<!-- Platforms and Readiness: multi-select, OR matching, built like the date filter. The button, popup,
     checkboxes and Clear are wired by SettingsWindow.MultiSelectFilter from JobTracker's explicit
     choice orders. The selections live only in this window. Right-docked, so Readiness sits LEFT of
     Platforms. -->
<Grid DockPanel.Dock="Right" Margin="8,0,0,0">
<ToggleButton x:Name="PlatformFilterButton" Width="132" Height="28" FontSize="11.5" HorizontalContentAlignment="Left"
              Padding="8,0" Content="All platforms"
              ToolTip="Show jobs from any of the ticked application platforms"/>
<Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{DynamicResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
      Margin="0,0,8,0" IsHitTestVisible="False"/>
<Popup x:Name="PlatformFilterPopup" PlacementTarget="{Binding ElementName=PlatformFilterButton}" Placement="Bottom"
       StaysOpen="False" AllowsTransparency="True">
<Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
        CornerRadius="8" Padding="10,8" Margin="0,4,8,8" MinWidth="160">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="#000000"/></Border.Effect>
<StackPanel>
<StackPanel x:Name="PlatformCheckList"/>
<Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,6,0,4"/>
<Button x:Name="PlatformClearButton" Content="Clear" HorizontalAlignment="Left" Padding="2,1" FontSize="11.5"
        Style="{DynamicResource BtnGhost}" Foreground="{DynamicResource Accent.Default}" Cursor="Hand"/>
</StackPanel>
</Border>
</Popup>
</Grid>
<Grid DockPanel.Dock="Right" Margin="8,0,0,0">
<ToggleButton x:Name="ReadinessFilterButton" Width="132" Height="28" FontSize="11.5" HorizontalContentAlignment="Left"
              Padding="8,0" Content="All readiness"
              ToolTip="Show jobs in any of the ticked readiness states"/>
<Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="{DynamicResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
      Margin="0,0,8,0" IsHitTestVisible="False"/>
<Popup x:Name="ReadinessFilterPopup" PlacementTarget="{Binding ElementName=ReadinessFilterButton}" Placement="Bottom"
       StaysOpen="False" AllowsTransparency="True">
<Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
        CornerRadius="8" Padding="10,8" Margin="0,4,8,8" MinWidth="160">
<Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" Color="#000000"/></Border.Effect>
<StackPanel>
<StackPanel x:Name="ReadinessCheckList"/>
<Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,6,0,4"/>
<Button x:Name="ReadinessClearButton" Content="Clear" HorizontalAlignment="Left" Padding="2,1" FontSize="11.5"
        Style="{DynamicResource BtnGhost}" Foreground="{DynamicResource Accent.Default}" Cursor="Hand"/>
</StackPanel>
</Border>
</Popup>
</Grid>
<Grid>
<TextBox x:Name="TrackingSearchBox" Height="28" VerticalContentAlignment="Center" Padding="8,0" FontSize="11.5"
         TextChanged="TrackingSearch_Changed"/>
<TextBlock Text="Search applications..." Foreground="{DynamicResource Text.Muted}" FontSize="11.5" Margin="11,0,0,0"
           IsHitTestVisible="False" VerticalAlignment="Center">
<TextBlock.Style>
<Style TargetType="TextBlock">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding Text, ElementName=TrackingSearchBox}" Value="">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</TextBlock.Style>
</TextBlock>
</Grid>
</DockPanel>
</Border>

<!-- ===== list view ===== -->
<Border x:Name="ListViewCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Padding="0">
<Grid>
<DataGrid x:Name="TrackingGrid" MaxHeight="420" AutoGenerateColumns="False" IsReadOnly="False"
          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" FontSize="11.5"
          BorderThickness="0" Background="Transparent"
          RowBackground="{DynamicResource Bg.Surface}"
          AlternatingRowBackground="{DynamicResource Bg.SurfaceRaised}"
          Foreground="{DynamicResource Text.Primary}"
          RowHeight="34" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
          MouseDoubleClick="TrackingGrid_DoubleClick" PreviewMouseRightButtonDown="TrackingGrid_RightButtonDown"
          SizeChanged="TrackingGrid_SizeChanged"
          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
<DataGrid.Resources>
<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
<Setter Property="Background" Value="{DynamicResource Bg.Input}"/>
<Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
</Style>
<Style TargetType="DataGridColumnHeader">
<Setter Property="Background" Value="{DynamicResource Bg.SurfaceRaised}"/>
<Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
<Setter Property="FontSize" Value="10.5"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Padding" Value="10,7"/>
<Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
<Setter Property="BorderThickness" Value="0,0,0,1"/>
<Setter Property="HorizontalContentAlignment" Value="Left"/>
</Style>
<Style TargetType="DataGridCell">
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Padding" Value="10,0"/>
<Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
<Setter Property="VerticalContentAlignment" Value="Center"/>
<Style.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
<Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
</Trigger>
</Style.Triggers>
</Style>
</DataGrid.Resources>
<DataGrid.ContextMenu>
<ContextMenu>
<MenuItem Header="Open Job Posting" Click="TrackingOpenUrl_Click"/>
<MenuItem Header="Open Application" Click="TrackingOpenApply_Click"/>
<MenuItem Header="Mark Applied" Click="TrackingMarkApplied_Click"/>
<MenuItem Header="Open Resume" Click="TrackingOpenResume_Click"/>
<MenuItem Header="Open Resume Folder" Click="TrackingOpenResumeFolder_Click"/>
<Separator/>
<MenuItem Header="Viewed" Tag="Viewed" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Ready" Tag="Ready" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Applied" Tag="Applied" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Interview" Tag="Interview" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Done" Tag="Done" Click="TrackingSetStatus_Click"/>
</ContextMenu>
</DataGrid.ContextMenu>
<DataGrid.Columns>
<DataGridTemplateColumn Header="Job" Width="2*" MinWidth="150" MaxWidth="420">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<!-- Title, then the platform badge; the title trims first so the badge always stays visible. -->
<DockPanel VerticalAlignment="Center">
<ContentControl DockPanel.Dock="Right" Style="{StaticResource PlatformBadgeStyle}" Margin="6,0,0,0"/>
<TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
</DockPanel>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="1.3*" MinWidth="110" MaxWidth="280" IsReadOnly="True">
<DataGridTextColumn.ElementStyle>
<Style TargetType="TextBlock">
<Setter Property="VerticalAlignment" Value="Center"/>
<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
</Style>
</DataGridTextColumn.ElementStyle>
</DataGridTextColumn>
<DataGridTemplateColumn Header="Status" Width="140" MinWidth="140">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<ComboBox x:Name="StatusPicker" Style="{StaticResource StatusPickerStyle}"
          ItemsSource="{StaticResource StatusChoices}"
          SelectedItem="{Binding ApplicationStatus, Mode=OneWay}"
          SelectionChanged="TrackingStatusBox_Changed"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="Readiness" Width="116" MinWidth="116">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Style="{StaticResource ReadinessTextStyle}" VerticalAlignment="Center" FontSize="11"/>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Date" Binding="{Binding TrackingDateDisplay}" Width="88" MinWidth="88" IsReadOnly="True">
<DataGridTextColumn.ElementStyle>
<Style TargetType="TextBlock">
<Setter Property="VerticalAlignment" Value="Center"/>
<Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
<!-- Which date this is: every recorded stage (Viewed / Ready / Applied / ...), one per line. -->
<Setter Property="ToolTip" Value="{Binding Converter={StaticResource JobDateText}, ConverterParameter=Stages}"/>
</Style>
</DataGridTextColumn.ElementStyle>
</DataGridTextColumn>
<DataGridTemplateColumn Header="Actions" Width="336" MinWidth="336">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<Button Content="Open Job" Padding="8,4" FontSize="10.5" Click="TrackingOpenUrl_Click"
        ToolTip="Open the job posting in your browser"/>
<!-- The recorded application page (ApplyUrl), never the Jobright link. Disabled until one is recorded. -->
<Button Content="Apply" Padding="8,4" FontSize="10.5" Margin="5,0,0,0" Click="TrackingOpenApply_Click"
        IsEnabled="{Binding ApplyUrl, Converter={StaticResource OpenableUrl}}"
        ToolTip="{Binding ApplyUrl}" ToolTipService.ShowOnDisabled="False"/>
<!-- The user's own "I applied" (ApplicationStatus, never the queue Status). Viewed / Ready only; once
     Applied or later it is disabled and its tooltip shows the recorded stage dates. -->
<Button Content="Mark Applied" Padding="8,4" FontSize="10.5" Margin="5,0,0,0" Click="TrackingMarkApplied_Click"
        IsEnabled="{Binding ApplicationStatus, Converter={StaticResource CanMarkApplied}}"
        ToolTip="{Binding Converter={StaticResource JobDateText}, ConverterParameter=Stages}"
        ToolTipService.ShowOnDisabled="True"/>
<Button Content="Resume" Padding="8,4" FontSize="10.5" Margin="5,0,0,0" Click="TrackingOpenResume_Click"
        IsEnabled="{Binding ResumeGenerated}" ToolTip="Open the generated DOCX"/>
<Button Content="Folder" Padding="8,4" FontSize="10.5" Margin="5,0,0,0" Click="TrackingOpenResumeFolder_Click"
        IsEnabled="{Binding ResumeGenerated}" ToolTip="Open the folder the resume was written to"/>
</StackPanel>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
</DataGrid>
<TextBlock x:Name="ListEmptyText" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
           Text="No applications found."/>
</Grid>
</Border>

<!-- ===== board view ===== -->
<Border x:Name="BoardViewCard" Style="{StaticResource DashboardCardStyle}" Margin="0,10,0,0" Visibility="Collapsed">
<ItemsControl x:Name="BoardView">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Background="{DynamicResource Bg.App}" CornerRadius="7" Margin="3,0" Padding="7,7,7,3">
<StackPanel>
<DockPanel Margin="1,0,1,7">
<Path Data="{Binding Icon}" Fill="{Binding Foreground}" Width="11" Height="11" Stretch="Uniform"
      VerticalAlignment="Center" Margin="0,0,5,0"/>
<TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding Foreground}"
           VerticalAlignment="Center"/>
<Border DockPanel.Dock="Right" Background="{Binding Background}" CornerRadius="8" Padding="7,1"
        HorizontalAlignment="Right">
<TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Foreground}"/>
</Border>
</DockPanel>
<ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
<StackPanel>
<ItemsControl ItemsSource="{Binding Jobs}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource BoardCardStyle}">
<Border.ContextMenu>
<ContextMenu>
<MenuItem Header="Open Job Posting" Click="TrackingOpenUrl_Click"/>
<MenuItem Header="Open Application" Click="TrackingOpenApply_Click"/>
<MenuItem Header="Mark Applied" Click="TrackingMarkApplied_Click"/>
<MenuItem Header="Open Resume" Click="TrackingOpenResume_Click"/>
<MenuItem Header="Open Resume Folder" Click="TrackingOpenResumeFolder_Click"/>
<Separator/>
<MenuItem Header="Viewed" Tag="Viewed" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Ready" Tag="Ready" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Applied" Tag="Applied" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Interview" Tag="Interview" Click="TrackingSetStatus_Click"/>
<MenuItem Header="Done" Tag="Done" Click="TrackingSetStatus_Click"/>
</ContextMenu>
</Border.ContextMenu>
<StackPanel>
<StackPanel Orientation="Horizontal">
<Path Style="{StaticResource StatusIconStyle}" Width="10" Height="10" Margin="0,0,4,0"/>
<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Text.Primary}"
           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
</StackPanel>
<DockPanel>
<ContentControl DockPanel.Dock="Right" Style="{StaticResource PlatformBadgeStyle}" Margin="6,1,0,0"/>
<TextBlock Text="{Binding Company}" FontSize="10" Foreground="{DynamicResource Text.Muted}"
           TextTrimming="CharacterEllipsis"/>
</DockPanel>
<DockPanel Margin="0,5,0,0">
<TextBlock Text="{Binding Converter={StaticResource JobDateText}}" FontSize="9.5" Foreground="{DynamicResource Text.Muted}"
           ToolTip="{Binding Converter={StaticResource JobDateText}, ConverterParameter=Stages}"/>
<TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="9.5"
           Style="{StaticResource ReadinessTextStyle}"/>
</DockPanel>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
<TextBlock Text="Nothing here" Foreground="{DynamicResource Text.Muted}" FontSize="10" HorizontalAlignment="Center"
           Margin="0,10,0,12" Visibility="{Binding EmptyVisibility}"/>
</StackPanel>
</ScrollViewer>
</StackPanel>
</Border>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Border>

<TextBlock x:Name="TrackingStatus" Margin="2,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text.Muted}"
           Text="Double-click a row to open the job posting. Right-click a row or card for status and resume actions. Resume Builder only sets Ready by itself, when a resume has been generated."/>
</StackPanel>
</ScrollViewer>
</Grid>
</TabItem>
  
  <TabItem Header="Development">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="720">
     <TextBlock Text="Development" Style="{DynamicResource PageTitleStyle}"/>
     <TextBlock Text="Synthetic jobs and testing resets. Real candidate data is never invented." Style="{DynamicResource PageSubtitleStyle}"/>
     <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="Sample Input" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
       <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                  Text="Writes one job file per job to Incoming — { company, title, jobUrl, companyUrl, description } — and uses the normal importer."/>
       <StackPanel Orientation="Horizontal">
        <Button Content="Load Sample Jobs" Width="160" Height="34" Click="LoadSampleJobs_Click"/>
        <Button Content="Load 50 Sample Jobs" Width="170" Height="34" Margin="10,0,0,0" Click="LoadStressJobs_Click"/>
       </StackPanel>
       <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                  Text="&quot;Load 50 Sample Jobs&quot; writes 50 synthetic jobs to Incoming for queue stress testing. Nothing is written until you click it."/>
       <TextBlock Margin="0,18,0,4" Text="Test Data" FontWeight="SemiBold"/>
       <TextBlock Foreground="{DynamicResource Text.Secondary}"
                  Text="Google — Senior Software Engineer&#10;Stripe — Backend Engineer&#10;Amazon — Software Engineer II"/>
       <Button Content="Remove Sample Jobs" Width="170" Height="34" HorizontalAlignment="Left" Margin="0,14,0,0"
               Click="ClearTestQueue_Click"
               ToolTip="Removes only the synthetic sample/stress jobs, leaving your real jobs alone"/>
       <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                  Text="Removes only the synthetic sample and stress jobs. Your real jobs, their results and their documents are untouched."/>
      </StackPanel>
     </Border>
     <Border Style="{DynamicResource CardStyle}">
      <StackPanel>
       <TextBlock Text="Reset For Testing" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
       <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                  Text="Clear Job History removes every job (Active and History) with its application tracking, and the result files Resume Builder saved for those jobs. Your settings, prompt files, candidate profile, Job Browser sign-in, diagnostics log and Incoming/Imported files are not touched."/>
       <CheckBox x:Name="ClearDocumentsBox" Margin="0,12,0,0" Content="Also delete generated resume folders (DOCX/PDF) for these jobs"/>
       <Button Content="Clear Job History…" Style="{DynamicResource BtnDanger}" Width="180" Height="34"
               HorizontalAlignment="Left" Margin="0,12,0,0" Click="ClearJobHistory_Click"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

 </TabControl>
 </Grid>
</UserControl>
