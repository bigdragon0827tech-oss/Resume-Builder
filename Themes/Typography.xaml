<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <FontFamily x:Key="Font.UI">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
  <system:Double x:Key="Font.Size.Caption">11</system:Double>
  <system:Double x:Key="Font.Size.Body">13</system:Double>
  <system:Double x:Key="Font.Size.BodyLarge">14</system:Double>
  <system:Double x:Key="Font.Size.Title">22</system:Double>
  <system:Double x:Key="Font.Size.Section">14</system:Double>
</ResourceDictionary>
