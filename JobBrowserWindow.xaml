<Window x:Class="ResumeBuilder.JobBrowserWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Job Browser" Height="820" Width="1180" MinHeight="480" MinWidth="780">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="26"/></Grid.RowDefinitions>

  <Border Background="#F3F7F8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
   <DockPanel Margin="10,0" LastChildFill="True">
    <Button x:Name="BackButton" Content="◀" Width="34" Margin="0,7,4,7" Padding="0" FontSize="13"
            ToolTip="Back" IsEnabled="False" Click="Back_Click"/>
    <Button x:Name="ForwardButton" Content="▶" Width="34" Margin="0,7,4,7" Padding="0" FontSize="13"
            ToolTip="Forward" IsEnabled="False" Click="Forward_Click"/>
    <Button x:Name="RefreshButton" Content="⟳" Width="34" Margin="0,7,4,7" Padding="0" FontSize="14"
            ToolTip="Refresh" IsEnabled="False" Click="Refresh_Click"/>
    <Button x:Name="HomeButton" Content="Jobright" Margin="0,7,10,7" Padding="12,0"
            ToolTip="Back to the Jobright home page" IsEnabled="False" Click="Home_Click"/>

    <!-- Enabled only on a single Jobright job page, once it has finished loading. -->
        <Button x:Name="ImportButton"
                DockPanel.Dock="Right"
                Content="⬇ Import Current Job"
                Margin="10,7,0,7"
                Padding="12,0"
                FontWeight="SemiBold"
                ToolTip="Open a single Jobright job to import it into the queue."
                Click="Import_Click"/>

        <!-- Automation Phase 1: find jobs on the current Jobright results page. -->
        
        <ComboBox x:Name="JobTargetBox"
                DockPanel.Dock="Right"
                Width="70"
                Margin="8,7,0,7"
                VerticalContentAlignment="Center"
                SelectedIndex="1">
        <ComboBoxItem Content="20"/>
        <ComboBoxItem Content="50"/>
        <ComboBoxItem Content="100"/>
        <ComboBoxItem Content="200"/>
        <ComboBoxItem Content="500"/>
        </ComboBox>

        <Button x:Name="FindJobsButton"
                DockPanel.Dock="Right"
                Content="🔎 Find Jobs"
                Margin="8,7,0,7"
                Padding="12,0"
                FontWeight="SemiBold"
                IsEnabled="False"
                ToolTip="Find jobs on the current Jobright results page."
                Click="FindJobs_Click"/>

        <Button x:Name="StopFindingButton"
                DockPanel.Dock="Right"
                Content="■ Stop"
                Margin="8,7,0,7"
                Padding="12,0"
                FontWeight="SemiBold"
                IsEnabled="False"
                Click="StopFinding_Click"/>     

        <Button x:Name="AutoImportButton"
                DockPanel.Dock="Right"
                Content="▶ Import Found"
                Margin="8,7,0,7"
                Padding="12,0"
                FontWeight="SemiBold"
                IsEnabled="False"
                ToolTip="Import the jobs found on this page one by one."
                Click="AutoImport_Click"/>

        <TextBlock x:Name="FoundJobsText"
                DockPanel.Dock="Right"
                Text="Found: 0"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Foreground="#666"
                FontSize="11.5"/>

        <TextBox x:Name="AddressBox"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="True"
                VerticalContentAlignment="Center"
                Margin="0,7,0,7"
                Padding="8,0"
                FontSize="11.5"
                Foreground="#333"
                Background="White"
                ToolTip="The page you are on"/>
   </DockPanel>
  </Border>

  <!-- The outcome of the last import. Hidden until there is one; colour says what happened. -->
  <Border x:Name="ResultBanner" Grid.Row="1" Visibility="Collapsed" Padding="14,8" BorderThickness="0,0,0,1"
          Background="#E4F4E8" BorderBrush="#BFE3C8">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="22" Padding="0" VerticalAlignment="Top"
            Background="Transparent" BorderThickness="0" ToolTip="Dismiss" Click="DismissResult_Click"/>
    <StackPanel>
     <TextBlock x:Name="ResultHeadline" FontWeight="SemiBold" FontSize="13" Foreground="#1E7E34"/>
     <TextBlock x:Name="ResultDetail" FontSize="11.5" Foreground="#333" TextWrapping="Wrap" Margin="0,2,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Border x:Name="BrowserHost" Grid.Row="2" Background="#FAFAFA"/>

  <Border Grid.Row="3" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,1,0,0">
   <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center" FontSize="11" Foreground="#666"
              TextTrimming="CharacterEllipsis" Text="Starting the job browser…"/>
  </Border>
 </Grid>
</Window>
