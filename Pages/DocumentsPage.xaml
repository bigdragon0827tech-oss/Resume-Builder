<UserControl x:Class="ResumeBuilder.DocumentsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Resume Documents" Style="{DynamicResource PageTitleStyle}"/>
   <TextBlock Text="Generated DOCX and PDF files for completed jobs." Style="{DynamicResource PageSubtitleStyle}"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="Open Resume Root" Margin="8,0,0,0" Click="OpenRoot_Click"/>
   <Button DockPanel.Dock="Right" Content="Refresh" Margin="0,0,0,0" Click="Refresh_Click"/>
   <TextBox x:Name="SearchBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"
            TextChanged="Search_Changed" ToolTip="Search company or role"/>
  </DockPanel>
  <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
   <Grid>
    <DataGrid x:Name="DocsGrid" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="Transparent" BorderThickness="0" RowHeight="40"
              Foreground="{DynamicResource Text.Primary}"
              AlternatingRowBackground="{DynamicResource Bg.SurfaceRaised}"
              HorizontalGridLinesBrush="{DynamicResource Border.Subtle}"
              MouseDoubleClick="DocsGrid_DoubleClick">
     <DataGrid.Resources>
      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
     </DataGrid.Resources>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
      <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/>
      <DataGridTextColumn Header="Role" Binding="{Binding Title}" Width="2*"/>
      <DataGridTextColumn Header="DOCX" Binding="{Binding DocxLabel}" Width="70"/>
      <DataGridTextColumn Header="PDF" Binding="{Binding PdfLabel}" Width="70"/>
      <DataGridTemplateColumn Header="Actions" Width="220">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal">
          <Button Content="DOCX" Margin="0,0,6,0" Tag="{Binding}" Click="OpenDocx_Click"
                  IsEnabled="{Binding HasDocx}" Padding="8,2"/>
          <Button Content="PDF" Margin="0,0,6,0" Tag="{Binding}" Click="OpenPdf_Click"
                  IsEnabled="{Binding HasPdf}" Padding="8,2"/>
          <Button Content="Folder" Tag="{Binding}" Click="OpenFolder_Click"
                  IsEnabled="{Binding HasFolder}" Padding="8,2"/>
         </StackPanel>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="EmptyText" Text="No generated resumes yet." Style="{DynamicResource EmptyStateStyle}"
               Visibility="Collapsed"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
