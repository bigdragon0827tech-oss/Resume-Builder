<Window x:Class="ResumeBuilder.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResumeBuilder Activation"
        Icon="Assets/ResumeBuilder.ico"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111827"
        Foreground="#F3F4F6">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ResumeBuilder Activation"
                   Foreground="#F9FAFB"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Copy this Machine ID into the License Generator, then import the license made for this computer."
                   Foreground="#BFC7D5"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2"
                   Text="Machine ID"
                   Foreground="#F3F4F6"
                   FontSize="13"
                   Margin="0,0,0,6"/>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MachineIdBox"
                     Grid.Column="0"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Padding="10,8"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#182231"
                     Foreground="#F3F4F6"
                     BorderBrush="#4B5563"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="CopyMachineIdButton"
                    Grid.Column="1"
                    Content="Copy Machine ID"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="12,0"
                    Click="CopyMachineIdButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="License"
                   Foreground="#F3F4F6"
                   FontSize="13"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="LicenseTextBox"
                 Grid.Row="5"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="10"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="#182231"
                 Foreground="#F3F4F6"
                 CaretBrush="#F3F4F6"
                 BorderBrush="#4B5563"
                 BorderThickness="1"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="6"
                   Text=""
                   Foreground="#F3F4F6"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,12,0,12"/>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="ExitButton"
                    Content="Exit"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="ExitButton_Click"/>

            <Button x:Name="ActivateButton"
                    Content="Import / Activate"
                    Width="140"
                    Height="32"
                    IsDefault="True"
                    Click="ActivateButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
