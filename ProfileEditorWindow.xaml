<Window x:Class="ResumeBuilder.ProfileEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Profile" Height="240" Width="420" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg.App}"
 ShowInTaskbar="False">
 <StackPanel Margin="24">
  <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>
  <TextBlock Text="Name" Margin="0,16,0,4" Foreground="{DynamicResource Text.Secondary}"/>
  <TextBox x:Name="NameBox" Height="32"/>
  <Button x:Name="AvatarButton" Content="Choose picture" Height="32" Margin="0,12,0,0"
          HorizontalAlignment="Left" Style="{DynamicResource BtnGhost}" Click="Avatar_Click"/>
  <TextBlock x:Name="AvatarLabel" Margin="0,6,0,0" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="Cancel" Width="88" Height="32" Margin="0,0,8,0" Style="{DynamicResource BtnGhost}" Click="Cancel_Click"/>
   <Button Content="Save" Width="88" Height="32" Style="{DynamicResource BtnPrimary}" Click="Save_Click" IsDefault="True"/>
  </StackPanel>
 </StackPanel>
</Window>
