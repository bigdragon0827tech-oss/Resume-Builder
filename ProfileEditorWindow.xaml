<Window x:Class="ResumeBuilder.ProfileEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Profile" Width="420" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg.App}"
 ShowInTaskbar="False" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button Content="Cancel" MinWidth="96" MinHeight="34" Margin="0,0,8,0" Style="{DynamicResource SecondaryButtonStyle}"
           IsCancel="True" Click="Cancel_Click"/>
   <Button x:Name="ConfirmButton" Content="Save" MinWidth="96" MinHeight="34" Style="{DynamicResource PrimaryButtonStyle}"
           IsDefault="True" Click="Save_Click"/>
  </StackPanel>
  <StackPanel>
   <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
   <TextBlock Text="Name" Margin="0,16,0,6" Foreground="{DynamicResource Text.Secondary}"/>
   <TextBox x:Name="NameBox" MinHeight="40" FontSize="14"
            Background="{DynamicResource Bg.Input}"
            Foreground="{DynamicResource Text.Primary}"
            CaretBrush="{DynamicResource Text.Primary}"
            BorderBrush="{DynamicResource Border.Subtle}"
            BorderThickness="1"
            SelectionBrush="{DynamicResource Accent.Default}"
            SelectionTextBrush="#FFFFFF">
    <TextBox.Template>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="Bd" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6" SnapsToDevicePixels="True">
       <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                     HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                     Margin="12,8" Foreground="{TemplateBinding Foreground}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Default}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </TextBox.Template>
   </TextBox>
   <Button x:Name="AvatarButton" Content="Choose picture" MinHeight="34" Margin="0,12,0,0"
           HorizontalAlignment="Left" Padding="14,0" Style="{DynamicResource SecondaryButtonStyle}" Click="Avatar_Click"/>
   <Border x:Name="AvatarPreviewHost" Width="48" Height="48" Margin="0,12,0,0"
           HorizontalAlignment="Left" CornerRadius="24" ClipToBounds="True" Visibility="Collapsed"
           Background="{DynamicResource Bg.Input}">
    <Image x:Name="AvatarPreview" Stretch="UniformToFill" Width="48" Height="48"/>
   </Border>
   <TextBlock x:Name="AvatarLabel" Margin="0,8,0,0" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Visibility="Collapsed"/>
  </StackPanel>
 </DockPanel>
</Window>
