<Window x:Class="ResumeBuilder.ProfileChooserWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Resume Builder" Icon="Assets/ResumeBuilder.ico"
 Height="620" Width="860" MinHeight="520" MinWidth="720"
 WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Bg.App}">
 <DockPanel Margin="36,28,28,28">
  <TextBlock DockPanel.Dock="Top" Text="Who's using Resume Builder?" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock DockPanel.Dock="Top" Text="Each person has their own jobs, resumes, and settings."
             Foreground="{DynamicResource Text.Muted}" Margin="0,8,0,22"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <WrapPanel x:Name="Cards" Orientation="Horizontal"/>
  </ScrollViewer>
 </DockPanel>
</Window>
